<Window x:Class="RainWorldSaveManager.Views.CopySlotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Copy save slot"
        Width="760" Height="560" MinWidth="680" MinHeight="460"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <DataTemplate x:Key="CampaignLine">
            <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding}" Margin="0,1" />
        </DataTemplate>

        <DataTemplate x:Key="WarningLine">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"
                       Foreground="{StaticResource Brush.Warn}" />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding HeadlineText}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DirectionText}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Banner.Danger}" Margin="0,14,0,0">
            <TextBlock Text="{Binding ReplaceWarningText}" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Danger}" />
        </Border>

        <!-- Source on the left, the file being written over on the right and drawn loud -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <!-- Wide enough for the longest label, "Online slot 3  (online_sav3)". A
                             clipped one reads as a different slot than the one selected. -->
                        <ComboBox DockPanel.Dock="Right" x:Name="SourcePicker" Width="196"
                                  ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                  AutomationProperties.Name="Copy from" />
                        <TextBlock Text="COPY FROM" Style="{StaticResource Text.SectionLabel}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding SourceName}" Style="{StaticResource Text.Title}"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="2" Text="{Binding SourceSummary}" Style="{StaticResource Text.Muted}"
                               Margin="0,2,0,0" TextWrapping="Wrap" />
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding SourceCampaigns}" ItemTemplate="{StaticResource CampaignLine}" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock Grid.Column="1" Text="&#x2192;" FontSize="22" Margin="10,0,10,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.TextMuted}" />

            <Border Grid.Column="2" CornerRadius="5" Padding="12,10"
                    Background="{StaticResource Brush.DangerSoft}"
                    BorderBrush="{StaticResource Brush.Danger}"
                    BorderThickness="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <ComboBox DockPanel.Dock="Right" x:Name="TargetPicker" Width="196"
                                  ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                  AutomationProperties.Name="Replaces" />
                        <TextBlock Text="REPLACES" Style="{StaticResource Text.SectionLabel}"
                                   Foreground="{StaticResource Brush.Danger}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{Binding TargetName}" Style="{StaticResource Text.Title}"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.Danger}" />
                    <TextBlock Grid.Row="2" Text="{Binding TargetSummary}" Style="{StaticResource Text.Muted}"
                               Margin="0,2,0,0" TextWrapping="Wrap" />
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding TargetCampaigns}" ItemTemplate="{StaticResource CampaignLine}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Banner.Warn}" Margin="0,12,0,0"
                Visibility="{Binding WarningsVisibility}">
            <ItemsControl ItemsSource="{Binding Warnings}" ItemTemplate="{StaticResource WarningLine}" />
        </Border>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock TextWrapping="Wrap"
                       Text="The whole file is copied byte for byte. Nothing inside it is rewritten, so the campaigns, the checksum and the padding all arrive exactly as they are now." />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="A safety snapshot of the current save folder is taken first, so this copy can be undone by restoring that snapshot." />
        </StackPanel>

        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource Button.Danger}"
                        Margin="0,0,8,0" Click="OnCopy"
                        IsEnabled="{Binding CanCopy}" />
                <Button x:Name="CancelButton" Content="Cancel" IsDefault="True" IsCancel="True" />
            </StackPanel>
            <TextBlock Text="{Binding BlockedReason}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{StaticResource Brush.Danger}"
                       Visibility="{Binding BlockedReason, Converter={StaticResource StringToVis}}" />
        </DockPanel>
    </Grid>
</Window>
