<Window x:Class="RainWorldSaveManager.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <StackPanel Margin="20">
        <TextBlock Text="Settings" Style="{StaticResource Text.Title}" />

        <Border Style="{StaticResource Banner.Warn}" Margin="0,12,0,0"
                Visibility="{Binding HasIntroMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding IntroMessage}" TextWrapping="Wrap" Foreground="{StaticResource Brush.Warn}" />
        </Border>

        <TextBlock Text="GAME SAVE FOLDER" Style="{StaticResource Text.SectionLabel}" Margin="0,16,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding GameSavePath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Browse" Style="{StaticResource Button.Small}" Margin="8,0,0,0"
                    Command="{Binding BrowseSavePathCommand}" />
            <Button Grid.Column="2" Content="Auto-detect" Style="{StaticResource Button.Small}" Margin="8,0,0,0"
                    Command="{Binding AutoDetectCommand}" />
        </Grid>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,5,0,0" TextWrapping="Wrap"
                   Text="This is the folder the game writes sav, sav2, sav3, options and the mod folders into. It is only ever read." />

        <TextBlock Text="BACKUP FOLDER" Style="{StaticResource Text.SectionLabel}" Margin="0,18,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding BackupRootPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Browse" Style="{StaticResource Button.Small}" Margin="8,0,0,0"
                    Command="{Binding BrowseBackupRootCommand}" />
        </Grid>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,5,0,0" TextWrapping="Wrap"
                   Text="Snapshots are written here, one folder each. Keep it outside the save folder." />

        <TextBlock Text="LIBRARY FOLDER" Style="{StaticResource Text.SectionLabel}" Margin="0,18,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding LibraryRootPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Browse" Style="{StaticResource Button.Small}" Margin="8,0,0,0"
                    Command="{Binding BrowseLibraryRootCommand}" />
            <Button Grid.Column="2" Content="Default" Style="{StaticResource Button.Small}" Margin="8,0,0,0"
                    Command="{Binding UseDefaultLibraryRootCommand}" />
        </Grid>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,5,0,0" TextWrapping="Wrap"
                   Text="Named saves are kept here, one folder each, outside the game's three slots. Keep it outside both of the folders above." />

        <TextBlock Text="RAIN WORLD INSTALL FOLDER" Style="{StaticResource Text.SectionLabel}" Margin="0,18,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding GameInstallPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Browse" Style="{StaticResource Button.Small}" Margin="8,0,0,0"
                    Command="{Binding BrowseInstallPathCommand}" />
            <Button Grid.Column="2" Content="Auto-detect" Style="{StaticResource Button.Small}" Margin="8,0,0,0"
                    Command="{Binding AutoDetectInstallCommand}" />
        </Grid>
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,5,0,0" TextWrapping="Wrap"
                   Text="Only the slugcat portraits are read from here, and only to show them in this window. Leaving it blank or wrong costs the icons and nothing else: backups and restores work either way." />
        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="{Binding InstallStatus}"
                   Visibility="{Binding HasInstallStatus, Converter={StaticResource BoolToVis}}" />

        <Border Style="{StaticResource Banner.Danger}" Margin="0,16,0,0"
                Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Danger}" />
        </Border>

        <Border Style="{StaticResource Banner.Warn}" Margin="0,10,0,0"
                Visibility="{Binding HasSaveRootWarning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding SaveRootWarning}" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.Warn}" />
        </Border>

        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,16,0,0" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding SettingsFilePath}">
            <Run Text="Settings file:" />
            <Run Text="{Binding SettingsFilePath, Mode=OneWay}" />
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Save" Style="{StaticResource Button.Accent}" IsDefault="True" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
