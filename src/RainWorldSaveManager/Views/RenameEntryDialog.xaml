<Window x:Class="RainWorldSaveManager.Views.RenameEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Rename a library save"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <StackPanel Margin="20">
        <TextBlock Text="Rename a library save" Style="{StaticResource Text.Title}" />
        <TextBlock Text="Only the name and the note change. The save itself is not touched."
                   Style="{StaticResource Text.Muted}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,16" />

        <TextBlock Text="NAME" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" MaxLength="120" AutomationProperties.Name="Name" />

        <TextBlock Text="NOTE (OPTIONAL)" Style="{StaticResource Text.SectionLabel}" Margin="0,14,0,4" />
        <TextBox x:Name="NoteBox"
                 Height="96"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Note" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Rename" Style="{StaticResource Button.Accent}" IsDefault="True" Margin="0,0,8,0"
                    Click="OnRename" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
