<Window x:Class="RainWorldSaveManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RainWorldSaveManager"
        xmlns:vm="clr-namespace:RainWorldSaveManager.ViewModels"
        mc:Ignorable="d"
        Title="Rain World Save Manager"
        Height="720" Width="1150" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>

        <!-- Panel that lays chips and tiles out in rows and wraps them -->
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- One labelled value. A value the save never recorded arrives as a dash and is drawn
             muted, so a gap in the data reads as a gap rather than as a missing control. -->
        <DataTemplate x:Key="StatTileTemplate">
            <!-- The tooltip sits on the whole tile so the label and the padding hover too. -->
            <Border Style="{StaticResource StatTile}" ToolTip="{Binding HoverText}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}"
                               Style="{StaticResource Text.SectionLabel}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Value}" Margin="0,3,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Value}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A flag: filled when the campaign has it, outlined and dimmed when it does not -->
        <DataTemplate x:Key="BadgeTemplate">
            <Border Margin="0,0,5,5" CornerRadius="3" Padding="8,3" BorderThickness="1" SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Brush.PanelAlt}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding On}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.OkSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Ok}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Text}" FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                            <Setter Property="FontSize" Value="11" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding On}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Ok}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChipTemplate">
            <Border Style="{StaticResource Chip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Margin="5,0,0,0"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Visibility="{Binding Detail, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A passage the run has earned and not yet spent is filled green, which is the one the
             game offers. A passage already used to travel is filled slate. Everything else is a
             plain chip. -->
        <DataTemplate x:Key="PassageTemplate">
            <Border ToolTip="{Binding ToolTipText}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Spent}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.Selection}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Available}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.OkSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Ok}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Spent}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Available}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Ok}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Margin="5,0,0,0"
                               Foreground="{StaticResource Brush.TextMuted}"
                               Visibility="{Binding ProgressText, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="KillTemplate">
            <Border Style="{StaticResource Chip}" ToolTip="{Binding CreatureId}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="{Binding CountText}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"
                               Foreground="{StaticResource Brush.Accent}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- The chevron on a node that is carrying something. Bare so it reads as an outline
             marker rather than a button in the middle of a table. -->
        <Style x:Key="TreeToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8 Z"
                                  Fill="{StaticResource Brush.TextMuted}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.4,0.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One entity in a stomach chain, then whatever it is carrying, drawn by this same
             template one level in. The ItemsControl below names no ItemTemplate, so WPF matches
             this implicit one on DataType and the nesting recurses on its own.
             A root is the outermost thing, which is the player in most saves but the predator
             when the player is the one that has been eaten. It carries no status or food of its
             own, because nothing in the save is holding it. -->
        <DataTemplate DataType="{x:Type vm:DevourmentNodeViewModel}">
            <StackPanel>
                <Grid Margin="0,0,0,3" ToolTip="{Binding ToolTipText}" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="{Binding Indent}">
                        <ToggleButton Style="{StaticResource TreeToggle}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      Visibility="{Binding HasContents, Converter={StaticResource BoolToVis}}" />
                        <!-- Keeps a leaf's name aligned with the names of its siblings that have
                             a chevron. -->
                        <Border Width="14"
                                Visibility="{Binding HasContents, Converter={StaticResource NotBoolToVis}}" />

                        <TextBlock Text="{Binding Type}" FontSize="12" Margin="4,0,0,0"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="FontSize" Value="12" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsItem}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border CornerRadius="2" Padding="4,0" Margin="6,0,0,0" BorderThickness="1"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasKind, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Brush.PanelAlt}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsItem}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.WarnSoft}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Tiny}" FontSize="10" />
                        </Border>

                        <!-- The pearl's own colour, so one lore pearl is told from another at a
                             glance. Outlined when it is a generic pickup with no lore. -->
                        <Border CornerRadius="2" Padding="4,0" Margin="6,0,0,0" BorderThickness="1"
                                VerticalAlignment="Center"
                                BorderBrush="{Binding PearlBrush}"
                                Visibility="{Binding HasPearl, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{Binding PearlBrush}"
                                         Stroke="{StaticResource Brush.Border}" StrokeThickness="0.5" />
                                <TextBlock Text="{Binding PearlLabel}" Style="{StaticResource Text.Tiny}"
                                           FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- On the campaign's FRIENDS list. Deliberately separate from the like
                             value beside it, because a creature can like the player completely
                             and still not be tamed. -->
                        <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Padding="4,0"
                                Background="{StaticResource Brush.OkSoft}"
                                BorderBrush="{StaticResource Brush.Ok}"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsTamedFriend, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="tamed" FontSize="10"
                                       Foreground="{StaticResource Brush.Ok}" FontWeight="SemiBold" />
                        </Border>

                        <TextBlock Text="{Binding SocialText}"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding SocialText, Converter={StaticResource StringToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Tiny}">
                                    <Setter Property="FontSize" Value="10" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DislikesPlayer}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Warn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Padding="4,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasMeat, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding MeatText}" Style="{StaticResource Text.Tiny}" FontSize="10" />
                        </Border>

                        <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Padding="4,0"
                                Background="{StaticResource Brush.WarnSoft}"
                                BorderBrush="{StaticResource Brush.Warn}"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasSpear, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SpearText}" FontSize="10"
                                       Foreground="{StaticResource Brush.Warn}" FontWeight="SemiBold" />
                        </Border>

                        <TextBlock Text="{Binding ContentsSummary}" Style="{StaticResource Text.Tiny}"
                                   FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding HasContents, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="loops back" Style="{StaticResource Text.Tiny}"
                                   FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Warn}"
                                   Visibility="{Binding RepeatsAncestor, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding FoodText}" FontSize="12"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Contents}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- The header strip of a campaign card. Clicking it opens and closes the card. -->
        <Style x:Key="CampaignHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.PanelAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One campaign: a scannable line, and four groups of detail behind it -->
        <DataTemplate x:Key="CampaignCardTemplate">
            <Border CornerRadius="5" Margin="0,0,0,8"
                    Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- The slugcat's own colour, kept to a strip so the window stays neutral -->
                    <Border Grid.Column="0" Background="{Binding Portrait.Accent}" CornerRadius="4,0,0,4" />

                    <StackPanel Grid.Column="1">
                        <Button Style="{StaticResource CampaignHeaderButton}" Command="{Binding ToggleCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  Content="{Binding Portrait}"
                                                  ContentTemplate="{StaticResource Portrait.Large}"
                                                  VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Title}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SlugcatId}" Style="{StaticResource Text.Tiny}"
                                               Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding ShowSlugcatId, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <!-- Karma as the meter reads it. A campaign whose stored number the game
                                     will clamp gets a heavier border and an asterisk pointing at the
                                     tooltip, which is a footnote rather than a fault: the save is fine. -->
                                <Border Grid.Column="2" Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        ToolTip="{Binding KarmaToolTip}">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KarmaStoredOutOfRange}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Karma" Style="{StaticResource Text.Tiny}" Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding KarmaText}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                                    <Setter Property="FontSize" Value="12" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasKarma}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="*" Style="{StaticResource Text.Tiny}" Margin="2,0,0,0"
                                                   VerticalAlignment="Top"
                                                   Visibility="{Binding KarmaStoredOutOfRange, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource Chip}" Margin="0,0,6,0"
                                        VerticalAlignment="Center" ToolTip="{Binding CycleToolTip}">
                                    <TextBlock Text="{Binding CycleText}" FontSize="12" />
                                </Border>

                                <Border Grid.Column="4" CornerRadius="3" Padding="7,2" BorderThickness="1"
                                        Margin="0,0,6,0" VerticalAlignment="Center"
                                        Background="{StaticResource Brush.Selection}"
                                        BorderBrush="{StaticResource Brush.Accent}"
                                        Visibility="{Binding HasDevourment, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding DevourmentChipText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Accent}" />
                                </Border>

                                <Grid Grid.Column="5" Width="12" Height="8" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <Path Data="M 1,1 L 6,6 L 11,1"
                                          Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.6"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource NotBoolToVis}}" />
                                    <Path Data="M 1,6 L 6,1 L 11,6"
                                          Stroke="{StaticResource Brush.TextMuted}" StrokeThickness="1.6"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Grid>
                        </Button>

                        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="14,4,14,12">

                                <DockPanel Margin="0,10,0,7">
                                    <TextBlock DockPanel.Dock="Left" Text="RUN" Margin="0,0,8,0"
                                               Style="{StaticResource Text.SectionLabel}" />
                                    <Border Height="1" Background="{StaticResource Brush.Border}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding RunStats}"
                                              ItemTemplate="{StaticResource StatTileTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}" />

                                <DockPanel Margin="0,10,0,7">
                                    <TextBlock DockPanel.Dock="Left" Text="KARMA" Margin="0,0,8,0"
                                               Style="{StaticResource Text.SectionLabel}" />
                                    <Border Height="1" Background="{StaticResource Brush.Border}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding KarmaStats}"
                                              ItemTemplate="{StaticResource StatTileTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}" />
                                <ItemsControl ItemsSource="{Binding Badges}"
                                              ItemTemplate="{StaticResource BadgeTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}"
                                              Margin="0,2,0,0" />

                                <DockPanel Margin="0,10,0,7">
                                    <TextBlock DockPanel.Dock="Left" Text="PROGRESS" Margin="0,0,8,0"
                                               Style="{StaticResource Text.SectionLabel}" />
                                    <Border Height="1" Background="{StaticResource Brush.Border}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding ProgressStats}"
                                              ItemTemplate="{StaticResource StatTileTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}" />

                                <TextBlock Text="ECHOES MET" Style="{StaticResource Text.SectionLabel}" Margin="0,4,0,4" />
                                <ItemsControl ItemsSource="{Binding Echoes}"
                                              ItemTemplate="{StaticResource ChipTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}"
                                              Visibility="{Binding HasEchoes, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="No echoes recorded." Style="{StaticResource Text.Muted}"
                                           Visibility="{Binding HasEchoes, Converter={StaticResource NotBoolToVis}}" />

                                <TextBlock Text="{Binding GateCountText}" Style="{StaticResource Text.SectionLabel}"
                                           Margin="0,8,0,4" />
                                <ItemsControl ItemsSource="{Binding Gates}"
                                              ItemTemplate="{StaticResource ChipTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}"
                                              Visibility="{Binding HasGates, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="PASSAGES" Style="{StaticResource Text.SectionLabel}" Margin="0,8,0,4" />
                                <ItemsControl ItemsSource="{Binding Passages}"
                                              ItemTemplate="{StaticResource PassageTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}"
                                              Visibility="{Binding HasPassages, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="No passages recorded." Style="{StaticResource Text.Muted}"
                                           Visibility="{Binding HasPassages, Converter={StaticResource NotBoolToVis}}" />

                                <TextBlock Text="{Binding KillSummaryText}" Style="{StaticResource Text.SectionLabel}"
                                           Margin="0,8,0,4" />
                                <ItemsControl ItemsSource="{Binding TopKills}"
                                              ItemTemplate="{StaticResource KillTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}"
                                              Visibility="{Binding HasKills, Converter={StaticResource BoolToVis}}" />

                                <DockPanel Margin="0,10,0,7">
                                    <TextBlock DockPanel.Dock="Left" Text="DEVOURMENT" Margin="0,0,8,0"
                                               Style="{StaticResource Text.SectionLabel}" />
                                    <Border Height="1" Background="{StaticResource Brush.Border}" VerticalAlignment="Center" />
                                </DockPanel>

                                <StackPanel Visibility="{Binding HasDevourmentRows, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="58" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="CONTENTS" Style="{StaticResource Text.SectionLabel}" />
                                        <TextBlock Grid.Column="1" Text="STATUS" Style="{StaticResource Text.SectionLabel}" />
                                        <TextBlock Grid.Column="2" Text="FOOD" Style="{StaticResource Text.SectionLabel}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <!-- No ItemTemplate: the implicit template for the node type
                                         picks itself up again for each level of nesting. -->
                                    <ItemsControl ItemsSource="{Binding DevourmentRoots}" />
                                </StackPanel>

                                <!-- Outside the table panel above on purpose. This line is for the
                                     case where every DEVOURMENTSTATE field failed to parse, which
                                     is exactly when the table has no rows and that panel is
                                     collapsed. -->
                                <TextBlock Text="{Binding UnreadDevourmentText}"
                                           Style="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding UnreadDevourmentText, Converter={StaticResource StringToVis}}" />

                                <TextBlock Text="SWALLOWED ITEMS" Style="{StaticResource Text.SectionLabel}"
                                           Margin="0,8,0,4"
                                           Visibility="{Binding HasSwallowedItems, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding SwallowedItems}"
                                              ItemTemplate="{StaticResource ChipTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}"
                                              Visibility="{Binding HasSwallowedItems, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="HELD IN HAND" Style="{StaticResource Text.SectionLabel}"
                                           Margin="0,8,0,4"
                                           Visibility="{Binding HasHeldItems, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding HeldItems}"
                                              ItemTemplate="{StaticResource ChipTemplate}"
                                              ItemsPanel="{StaticResource WrapPanelTemplate}"
                                              Visibility="{Binding HasHeldItems, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Text="No Devourment state recorded."
                                           Style="{StaticResource Text.Muted}"
                                           Visibility="{Binding HasNothingDevourment, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One slot section in the detail panel -->
        <DataTemplate x:Key="SlotSectionTemplate">
            <StackPanel Margin="0,0,0,6">
                <DockPanel Margin="0,10,0,8">
                    <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="4"
                            Background="{StaticResource Brush.PanelAlt}"
                            BorderBrush="{StaticResource Brush.BorderStrong}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding NumberText}" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding HeaderText}"
                               Style="{StaticResource Text.Title}" Margin="9,0,0,0" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding CampaignCountText}"
                               Style="{StaticResource Text.Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Tiny}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DockPanel>

                <Border Style="{StaticResource Banner.Warn}" Margin="0,0,0,8"
                        Visibility="{Binding ChecksumBad, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="The checksum stored in this save file did not recompute. The game discards a save in that state."
                               TextWrapping="Wrap" Foreground="{StaticResource Brush.Warn}" />
                </Border>

                <ItemsControl ItemsSource="{Binding Campaigns}"
                              ItemTemplate="{StaticResource CampaignCardTemplate}" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                        Visibility="{Binding HasNoCampaigns, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- One half of a slot pair. A half with no file behind it still draws, dimmed: "there is
             no online save in this slot yet" is the state a player copying a local save across is
             starting from. -->
        <DataTemplate x:Key="SlotPairSideTemplate">
            <Border Padding="10,8" CornerRadius="5" BorderThickness="1"
                    Background="{StaticResource Brush.PanelAlt}"
                    BorderBrush="{StaticResource Brush.Border}"
                    SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Exists}" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding KindLabel}"
                                   Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.Tiny}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Portraits}"
                                  ItemTemplate="{StaticResource Portrait.Small}"
                                  ItemsPanel="{StaticResource WrapPanelTemplate}"
                                  Margin="0,7,0,0"
                                  Visibility="{Binding HasPortraits, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Muted}"
                               Margin="0,5,0,0" TextWrapping="Wrap"
                               ToolTip="{Binding SummaryText}" />

                    <TextBlock Text="checksum did not recompute" Margin="0,4,0,0"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Warn}"
                               Visibility="{Binding ChecksumBad, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A Border is a Decorator and WPF creates no automation peer for one, so a name set on
             it is dropped and its children are hoisted to the nearest ancestor peer. A GroupBox
             does have a peer, and this template strips its chrome so the row draws exactly as the
             Border alone did. -->
        <ControlTemplate x:Key="BareGroupTemplate" TargetType="GroupBox">
            <ContentPresenter />
        </ControlTemplate>

        <!-- One slot number with both of its files side by side, and the copy between them -->
        <DataTemplate x:Key="SlotPairTemplate">
            <GroupBox Template="{StaticResource BareGroupTemplate}"
                      AutomationProperties.Name="{Binding AccessibleName}">
            <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="5" BorderThickness="1"
                    Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                        <Border Width="24" Height="24" CornerRadius="4"
                                Background="{StaticResource Brush.PanelAlt}"
                                BorderBrush="{StaticResource Brush.BorderStrong}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding NumberText}" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding HeaderText}" Style="{StaticResource Text.Title}"
                                   Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Grid.Column="0" Margin="0,0,5,0"
                                          Content="{Binding Local}"
                                          ContentTemplate="{StaticResource SlotPairSideTemplate}" />

                        <StackPanel Grid.Column="1" Margin="6,0,6,0" VerticalAlignment="Center"
                                    Visibility="{Binding ShowCopy, Converter={StaticResource BoolToVis}}">
                            <Button Content="Copy &#x2192;" Style="{StaticResource Button.Small}" MinWidth="88"
                                    Command="{Binding CopyToOnlineCommand}"
                                    ToolTip="{Binding CopyToOnlineToolTip}"
                                    AutomationProperties.Name="{Binding CopyToOnlineAccessibleName}" />
                            <Button Content="&#x2190; Copy" Style="{StaticResource Button.Small}" MinWidth="88"
                                    Margin="0,6,0,0"
                                    Command="{Binding CopyToLocalCommand}"
                                    ToolTip="{Binding CopyToLocalToolTip}"
                                    AutomationProperties.Name="{Binding CopyToLocalAccessibleName}" />
                        </StackPanel>

                        <ContentPresenter Grid.Column="2" Margin="5,0,0,0"
                                          Content="{Binding Online}"
                                          ContentTemplate="{StaticResource SlotPairSideTemplate}" />
                    </Grid>
                </StackPanel>
            </Border>
            </GroupBox>
        </DataTemplate>

        <!-- One character out of meadow.json -->
        <DataTemplate x:Key="MeadowCharacterTemplate">
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}"
                                Background="{StaticResource Brush.Selection}"
                                BorderBrush="{StaticResource Brush.Accent}"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="selected in the menu" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Accent}" />
                        </Border>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Stats}"
                                  ItemTemplate="{StaticResource StatTileTemplate}"
                                  ItemsPanel="{StaticResource WrapPanelTemplate}"
                                  Margin="0,9,0,0" />

                    <TextBlock Text="{Binding EmoteCountText}" Style="{StaticResource Text.SectionLabel}"
                               Margin="0,6,0,4" />
                    <ItemsControl ItemsSource="{Binding Emotes}"
                                  ItemTemplate="{StaticResource ChipTemplate}"
                                  ItemsPanel="{StaticResource WrapPanelTemplate}"
                                  Visibility="{Binding HasEmotes, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="No emotes unlocked." Style="{StaticResource Text.Muted}"
                               Visibility="{Binding HasNoEmotes, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding SkinCountText}" Style="{StaticResource Text.SectionLabel}"
                               Margin="0,8,0,4" />
                    <ItemsControl ItemsSource="{Binding Skins}"
                                  ItemTemplate="{StaticResource ChipTemplate}"
                                  ItemsPanel="{StaticResource WrapPanelTemplate}"
                                  Visibility="{Binding HasSkins, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="No skins unlocked." Style="{StaticResource Text.Muted}"
                               Visibility="{Binding HasNoSkins, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One slot inside the live save card in the list column -->
        <DataTemplate x:Key="LiveSlotRowTemplate">
            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding NumberText}"
                           Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Portraits}"
                              ItemTemplate="{StaticResource Portrait.Small}"
                              ItemsPanel="{StaticResource WrapPanelTemplate}"
                              VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding SummaryText}"
                           Style="{StaticResource Text.Muted}" Margin="4,0,0,0"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="{Binding SummaryText}" />
            </Grid>
        </DataTemplate>

        <!-- The live save card is selected the same way a backup row is, so the panel on the
             right shows the save folder in the same shape as a snapshot. -->
        <Style x:Key="LiveCardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,10" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Marker" Width="3" HorizontalAlignment="Left"
                                        CornerRadius="5,0,0,5" Background="Transparent" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.PanelAlt}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsLiveSelected}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Selection}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Marker" Property="Background" Value="{StaticResource Brush.Accent}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One backup row. Faces first, so two backups can be told apart without selecting one. -->
        <DataTemplate x:Key="BackupRowTemplate">
            <StackPanel ToolTip="{Binding TooltipText}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <!-- A snapshot with no manifest cannot be restored, so it is kept
                                 visible but reads as unusable rather than as a normal row. -->
                            <DataTrigger Binding="{Binding IsComplete}" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}"
                               Style="{StaticResource Text.Tiny}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding CreatedText}"
                               Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CampaignCountText}" Style="{StaticResource Text.Tiny}"
                               Margin="8,0,6,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <TextBlock Text="{Binding LabelText}" FontWeight="SemiBold" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />

                <ItemsControl ItemsSource="{Binding Portraits}"
                              ItemTemplate="{StaticResource Portrait.Small}"
                              ItemsPanel="{StaticResource WrapPanelTemplate}"
                              Margin="0,6,0,0"
                              Visibility="{Binding HasPortraits, Converter={StaticResource BoolToVis}}" />

                <DockPanel Margin="0,5,0,0">
                    <Border DockPanel.Dock="Left" CornerRadius="3" Padding="6,1" BorderThickness="1"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Brush.PanelAlt}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSafetyBackup}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Brush.WarnSoft}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Warn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding KindText}" FontSize="10" />
                    </Border>

                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.BorderStrong}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Ok}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock Text="{Binding StateText}" FontSize="11" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Ok}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: whether the game is running, and every command -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Left" CornerRadius="3" Padding="10,5" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Brush.OkSoft}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Ok}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Ok}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding GameStatusText}" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Ok}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Button DockPanel.Dock="Left" Content="Refresh" Margin="10,0,0,0"
                        Style="{StaticResource Button.Small}"
                        Command="{Binding RefreshCommand}" />

                <Button DockPanel.Dock="Right" Content="Settings" Style="{StaticResource Button.Small}"
                        Command="{Binding OpenSettingsCommand}" />
                <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource Button.Danger}"
                        Margin="0,0,8,0" MinWidth="76" MinHeight="26" Padding="10,4" FontSize="12"
                        Command="{Binding DeleteCommand}" />
                <Button DockPanel.Dock="Right" Content="Open Folder" Style="{StaticResource Button.Small}"
                        Margin="0,0,8,0" Command="{Binding OpenFolderCommand}" />
                <Button DockPanel.Dock="Right" Content="Restore" Style="{StaticResource Button.Small}"
                        Margin="0,0,8,0" Command="{Binding RestoreCommand}" />
                <Button DockPanel.Dock="Right" Content="New Backup" Style="{StaticResource Button.Accent}"
                        Margin="0,0,8,0" MinWidth="98" MinHeight="26" Padding="10,4" FontSize="12"
                        Command="{Binding NewBackupCommand}" />
            </DockPanel>
        </Border>

        <!-- Configuration problem banner -->
        <Border Grid.Row="1"
                Style="{StaticResource Banner.Warn}"
                Margin="16,12,16,0"
                Visibility="{Binding HasConfigProblem, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ConfigProblem}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Warn}" />
                <Button Grid.Column="1"
                        Content="Open Settings"
                        Style="{StaticResource Button.Small}"
                        Margin="12,0,0,0"
                        Command="{Binding OpenSettingsCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16,12,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- List column: the live save, then every backup, newest first -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Style="{StaticResource LiveCardButton}" Command="{Binding SelectLiveCommand}"
                        AutomationProperties.Name="{Binding LiveAccessibleName}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="LIVE SAVE"
                                       Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LiveSummaryText}" Style="{StaticResource Text.Tiny}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding LiveSlots}"
                                      ItemTemplate="{StaticResource LiveSlotRowTemplate}"
                                      Visibility="{Binding HasLiveSlots, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="No save files were found in the configured folder."
                                   Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0"
                                   Visibility="{Binding HasNoLiveSlots, Converter={StaticResource BoolToVis}}" />

                        <!-- The rows above are the local saves. Rain Meadow's online saves share
                             those slot numbers, so they are paired with their local halves in the
                             detail panel and only counted here. -->
                        <TextBlock Text="{Binding LiveOnlineText}"
                                   Style="{StaticResource Text.Tiny}"
                                   Margin="0,7,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding LiveOnlineText, Converter={StaticResource StringToVis}}" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="1,16,0,7">
                    <TextBlock Text="BACKUPS" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BackupCountText}" Style="{StaticResource Text.Muted}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding Backups}"
                             SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                             ItemTemplate="{StaticResource BackupRowTemplate}">
                        <ListBox.ItemContainerStyle>
                            <!-- Without this a row announces itself as the view model type name. -->
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock Text="No backups yet. Use New Backup to make the first one."
                               Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <StackPanel Grid.Row="3" Margin="1,12,0,0">
                    <TextBlock Style="{StaticResource Text.Tiny}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SavePathText}">
                        <Run Text="Save folder:" />
                        <Run Text="{Binding SavePathText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Tiny}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding BackupRootText}">
                        <Run Text="Backup folder:" />
                        <Run Text="{Binding BackupRootText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- Detail panel: whatever is selected, slot by slot and campaign by campaign -->
            <Border Grid.Column="1" Margin="16,0,0,0"
                    Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,14,16,16"
                                  Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Detail.Title}"
                                               FontSize="19" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail.Subtitle}"
                                               Style="{StaticResource Text.Muted}"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Detail.Subtitle}" />
                                    <TextBlock Text="{Binding Detail.NoteText}"
                                               Style="{StaticResource Text.Body}"
                                               TextWrapping="Wrap"
                                               Margin="0,7,0,0"
                                               Visibility="{Binding Detail.HasNote, Converter={StaticResource BoolToVis}}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Border Style="{StaticResource Chip}">
                                            <TextBlock Text="{Binding Detail.KindText}" FontSize="11" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}">
                                            <TextBlock Text="{Binding Detail.FileCountText}" FontSize="11" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}">
                                            <TextBlock Text="{Binding Detail.SizeText}" FontSize="11" />
                                        </Border>
                                        <Border Style="{StaticResource Chip}">
                                            <TextBlock Text="{Binding Detail.CampaignCountText}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Detail.Backup.StateText}"
                                           Margin="12,3,0,0"
                                           VerticalAlignment="Top"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap"
                                           MaxWidth="220"
                                           Visibility="{Binding Detail.HasBackup, Converter={StaticResource BoolToVis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Detail.Backup.IsVerified}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Ok}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Detail.Backup.IsProblem}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,14,0,0" />

                            <ItemsControl ItemsSource="{Binding Detail.Slots}"
                                          ItemTemplate="{StaticResource SlotSectionTemplate}" />

                            <TextBlock Text="{Binding Detail.EmptyText}"
                                       Style="{StaticResource Text.Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,0"
                                       Visibility="{Binding Detail.HasNoSlots, Converter={StaticResource BoolToVis}}" />

                            <!-- Rain Meadow, in its own banded panel so the eye can see where the
                                 local saves above stop. The whole thing is left out when the mod is
                                 not on this machine, so a player who does not use it sees the panel
                                 exactly as it was. There is no foldout: if the mod is here, its
                                 saves are part of what this app manages. -->
                            <Border Margin="0,22,0,0" CornerRadius="4"
                                    Background="{StaticResource Brush.MeadowSoft}"
                                    BorderBrush="{StaticResource Brush.Meadow}"
                                    BorderThickness="1"
                                    Visibility="{Binding Detail.ShowMeadowSection, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <!-- The band across the top is the divider. It carries the
                                         section colour so the break reads before any text does. -->
                                    <Border Background="{StaticResource Brush.Meadow}"
                                            CornerRadius="3,3,0,0" Padding="12,7">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding Detail.MeadowVersionText}"
                                                       Foreground="White" FontSize="11" Opacity="0.85"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="RAIN MEADOW" Foreground="White"
                                                       FontWeight="SemiBold" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Detail.OnlineCountText}"
                                                       Foreground="White" Opacity="0.85" FontSize="11"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>

                                    <StackPanel Margin="12,10,12,12">
                                        <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                                   Margin="0,0,0,9"
                                                   Text="Rain Meadow keeps a second save for each slot and the game picks between them by whether you are in a lobby, so slot 2 is sav2 on your own and online_sav2 in a lobby. Copying replaces the whole target file byte for byte." />

                                        <ItemsControl ItemsSource="{Binding Detail.SlotPairs}"
                                                      ItemTemplate="{StaticResource SlotPairTemplate}" />

                                        <TextBlock Text="No online saves in this folder yet. Copy a local slot across to start one."
                                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                                   Visibility="{Binding Detail.HasNoOnlineSlots, Converter={StaticResource BoolToVis}}" />

                                        <StackPanel Margin="0,14,0,0"
                                                    Visibility="{Binding Detail.HasMeadow, Converter={StaticResource BoolToVis}}">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Left" Text="PROFILE" Margin="0,0,8,0"
                                                           Style="{StaticResource Text.SectionLabel}" />
                                                <Border Height="1" Background="{StaticResource Brush.Border}"
                                                        VerticalAlignment="Center" />
                                            </DockPanel>

                                            <TextBlock Text="{Binding Detail.Meadow.ErrorText}"
                                                       Style="{StaticResource Text.Muted}"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding Detail.Meadow.HasError, Converter={StaticResource BoolToVis}}" />

                                            <StackPanel Visibility="{Binding Detail.Meadow.HasProfile, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl ItemsSource="{Binding Detail.Meadow.Stats}"
                                                              ItemTemplate="{StaticResource StatTileTemplate}"
                                                              ItemsPanel="{StaticResource WrapPanelTemplate}" />

                                                <ItemsControl ItemsSource="{Binding Detail.Meadow.Characters}"
                                                              ItemTemplate="{StaticResource MeadowCharacterTemplate}"
                                                              Margin="0,6,0,0" />

                                                <TextBlock Text="meadow.json records no character progress yet."
                                                           Style="{StaticResource Text.Muted}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding Detail.Meadow.HasNoCharacters, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Text="Select the live save or a backup on the left to see what is in it."
                               Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="24"
                               Visibility="{Binding HasNoDetail, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Busy overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Panel.ZIndex="10"
                Background="{StaticResource Brush.Overlay}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}"
                    Width="400"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding BusyTitle}" Style="{StaticResource Text.Title}" />
                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,14,0,12"
                                 Background="{StaticResource Brush.PanelAlt}"
                                 BorderThickness="0"
                                 Foreground="{StaticResource Brush.Accent}" />
                    <TextBlock Text="{Binding BusyMessage}"
                               Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap"
                               MinHeight="34" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
