<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Palette: muted neutrals with one slate accent, plus green/red/amber for state -->
    <SolidColorBrush x:Key="Brush.Window" Color="#FFF2F2F0" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.PanelAlt" Color="#FFF8F8F6" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FFD9D9D3" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FFBDBDB5" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FF23262B" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF6C7079" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF4B6E7F" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFA33A34" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FFFBEDEC" />
    <SolidColorBrush x:Key="Brush.Ok" Color="#FF2E7D50" />
    <SolidColorBrush x:Key="Brush.OkSoft" Color="#FFEDF6F0" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#FF8A6D1F" />
    <SolidColorBrush x:Key="Brush.WarnSoft" Color="#FFFBF4E2" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#FFE1EAEE" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#66202225" />

    <!-- Text. These are keyed on purpose: an implicit TextBlock style would also repaint
         the text inside button and header templates. -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Text.SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="94" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.74" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Button.Base}" />

    <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
    </Style>

    <Style x:Key="Button.Small" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}" />
    </Style>

    <!-- Cards and banners -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="Banner.Warn" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.WarnSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Warn}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style x:Key="Banner.Danger" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <!-- Backup list -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="RowBackground" Value="{StaticResource Brush.Panel}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Brush.PanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Brush.PanelAlt}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="MinHeight" Value="34" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Selection}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The theme style highlights a selected cell, so selection colour is set on the row instead -->
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
