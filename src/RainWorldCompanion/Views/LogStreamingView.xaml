<UserControl x:Class="RainWorldCompanion.Views.LogStreamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RainWorldCompanion.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="960"
             KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources>
        <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:LogStreamingStatusTone.Danger}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:LogStreamingStatusTone.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:LogStreamingStatusTone.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:LogStreamingStatusTone.Danger}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:LogStreamingStatusTone.Success}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:LogStreamingStatusTone.Warning}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Tiny}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="DirectionTemplate">
            <Border Background="{DynamicResource Brush.PanelAlt}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                   Style="{StaticResource Text.SectionLabel}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" Margin="0,5,0,8" />
                    <UniformGrid Columns="6">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="RATE" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ThroughputText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="ACKNOWLEDGED" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding AcknowledgedText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="BACKLOG" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding BacklogText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="{Binding AcknowledgementAgeLabel}" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding AcknowledgementAgeText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="RECONNECTS" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding ReconnectCountText}" Style="{StaticResource MetricValue}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="LOG SESSION" Style="{StaticResource MetricLabel}" />
                            <TextBlock Text="{Binding LogSessionText}" Style="{StaticResource MetricValue}"
                                       ToolTip="{Binding LogSessionText}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PeerTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Background="{DynamicResource Brush.MeadowSoft}"
                                    BorderBrush="{DynamicResource Brush.Meadow}"
                                    BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="6,0,0,0">
                                <TextBlock Text="{Binding RoleText}" Foreground="{DynamicResource Brush.Meadow}"
                                           FontWeight="SemiBold" FontSize="10" />
                            </Border>
                            <Border Background="{DynamicResource Brush.Selection}"
                                    BorderBrush="{DynamicResource Brush.Accent}"
                                    BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="6,0,0,0"
                                    Visibility="{Binding IsLocal, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="YOU" Foreground="{DynamicResource Brush.Accent}"
                                           FontWeight="SemiBold" FontSize="10" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.Title}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ContentControl Content="{Binding Incoming}" Tag="THEIR LOGS TO YOU"
                                    ContentTemplate="{StaticResource DirectionTemplate}" />
                    <ContentControl Content="{Binding Outgoing}" Tag="YOUR LOGS TO THEM"
                                    ContentTemplate="{StaticResource DirectionTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <Border Style="{StaticResource Banner.Warn}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="WHAT SHARING INCLUDES" Style="{StaticResource Text.SectionLabel}"
                               Foreground="{DynamicResource Brush.Warn}" />
                    <TextBlock Text="{x:Static vm:LogStreamingViewModel.DisclosureText}"
                               TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource Card}" Margin="0,0,5,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="ACTIVE STREAMS" Style="{StaticResource Text.SectionLabel}" />
                        <TextBlock Text="{Binding ActiveStreamsText}" FontSize="20" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="2,0,3,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="COMBINED RATE" Style="{StaticResource Text.SectionLabel}" />
                        <TextBlock Text="{Binding CurrentThroughputText}" FontSize="20" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="3,0,2,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="SEND BACKLOG" Style="{StaticResource Text.SectionLabel}" />
                        <TextBlock Text="{Binding CurrentBacklogText}" FontSize="20" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="OLDEST ACK" Style="{StaticResource Text.SectionLabel}" />
                        <TextBlock Text="{Binding LongestAcknowledgementAgeText}" FontSize="20"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Receive logs" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="Advertise yourself, then start capture when everyone is ready. Your own logs and diagnostics are included for comparison."
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,10" />
                        <TextBlock Text="{Binding ReceiverStatusText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CaptureStatusText}" FontWeight="SemiBold" Margin="0,3,0,0" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{Binding ReceiverAdvertisementActionText}"
                                    Command="{Binding ToggleReceiverAdvertisementCommand}"
                                    Style="{StaticResource Button.Small}" Margin="0,0,6,6" />
                            <Button Content="Start capture" Command="{Binding StartCaptureCommand}"
                                    Style="{StaticResource Button.Accent}" Margin="0,0,6,6" />
                            <Button Content="Pause capture" Command="{Binding PauseCaptureCommand}"
                                    Style="{StaticResource Button.Small}" Margin="0,0,6,6" />
                            <Button Content="Stop capture" Command="{Binding StopCaptureCommand}"
                                    Style="{StaticResource Button.Danger}" Margin="0,0,6,6" />
                        </WrapPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="DEEP TRACE" Style="{StaticResource Text.SectionLabel}"
                                   Margin="0,12,0,3" />
                        <CheckBox Content="Deep trace"
                                  IsChecked="{Binding DeepTraceEnabled, Mode=OneWay}"
                                  Command="{Binding ToggleDeepTraceCommand}"
                                  ToolTip="The receiver can switch Deep trace during an approved stream. It samples player positions, inputs, and performance. It does not include chat or arbitrary files." />
                        <TextBlock Text="{Binding DeepTraceStatusText}" Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="OPTIONAL EVENT NOTE" Style="{StaticResource Text.SectionLabel}"
                                   Margin="0,10,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EventNote, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="160" Margin="0,0,6,0"
                                     AutomationProperties.Name="Optional event note"
                                     ToolTip="Optional note saved with the event marker" />
                            <Button Grid.Column="1" Content="Mark event" Command="{Binding MarkEventCommand}"
                                    Style="{StaticResource Button.Small}" />
                        </Grid>
                        <Button Content="Open capture folder" Command="{Binding OpenCaptureFolderCommand}"
                                Style="{StaticResource Button.Small}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Send my logs" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="Choose every advertised receiver you want to approve."
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,10" />
                        <ItemsControl ItemsSource="{Binding ReceiverChoices}"
                                      Visibility="{Binding HasReceiverChoices, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelectedReceiver, Mode=TwoWay}"
                                              IsEnabled="{Binding CanSelectAsReceiver}"
                                              Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock>
                                                <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="  " />
                                                <Run Text="{Binding RoleText, Mode=OneWay}" Foreground="{DynamicResource Brush.Meadow}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding IdentityText}" Style="{StaticResource Text.Muted}" />
                                            <TextBlock Text="{Binding ReceiverChoiceText}" Style="{StaticResource Text.Muted}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No one in this lobby is advertising as a receiver."
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                   Visibility="{Binding HasNoReceiverChoices, Converter={StaticResource BoolToVis}}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Share with selected" Command="{Binding PrepareSharingCommand}"
                                    Style="{StaticResource Button.Accent}" Margin="0,0,6,6" />
                            <Button Content="Revoke selected" Command="{Binding RevokeSelectedSharingCommand}"
                                    Style="{StaticResource Button.Small}" Margin="0,0,6,6" />
                            <Button Content="Revoke all" Command="{Binding RevokeAllSharingCommand}"
                                    Style="{StaticResource Button.Danger}" Margin="0,0,6,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Network history" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Confirmed log throughput for both directions during the last 60 seconds."
                       Style="{StaticResource Text.Muted}" Margin="0,3,0,8" />
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,5,0" Padding="10">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding ThroughputScaleText}" DockPanel.Dock="Right"
                                       Style="{StaticResource Text.Tiny}" />
                            <TextBlock Text="CONFIRMED LOG THROUGHPUT" Style="{StaticResource Text.SectionLabel}" />
                        </DockPanel>
                        <Border Height="105" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" Margin="0,7,0,0">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="600" Height="100" ClipToBounds="True">
                                    <Line X1="0" X2="600" Y1="50" Y2="50"
                                          Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" />
                                    <Polyline Points="{Binding ThroughputPoints}" Stroke="{DynamicResource Brush.Ok}"
                                              StrokeThickness="2.5" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <DockPanel Margin="0,3,0,0">
                            <TextBlock Text="60 s ago" Style="{StaticResource Text.Tiny}" />
                            <TextBlock Text="Now" Style="{StaticResource Text.Tiny}" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="2,0,3,0" Padding="10">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding BacklogScaleText}" DockPanel.Dock="Right"
                                       Style="{StaticResource Text.Tiny}" />
                            <TextBlock Text="SEND BACKLOG" Style="{StaticResource Text.SectionLabel}" />
                        </DockPanel>
                        <Border Height="105" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" Margin="0,7,0,0">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="600" Height="100" ClipToBounds="True">
                                    <Line X1="0" X2="600" Y1="50" Y2="50"
                                          Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" />
                                    <Polyline Points="{Binding BacklogPoints}" Stroke="{DynamicResource Brush.Warn}"
                                              StrokeThickness="2.5" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <DockPanel Margin="0,3,0,0">
                            <TextBlock Text="60 s ago" Style="{StaticResource Text.Tiny}" />
                            <TextBlock Text="Now" Style="{StaticResource Text.Tiny}" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0,0,0" Padding="10">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding AcknowledgementAgeScaleText}" DockPanel.Dock="Right"
                                       Style="{StaticResource Text.Tiny}" />
                            <TextBlock Text="ACK AGE" Style="{StaticResource Text.SectionLabel}" />
                        </DockPanel>
                        <Border Height="105" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" Margin="0,7,0,0">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="600" Height="100" ClipToBounds="True">
                                    <Line X1="0" X2="600" Y1="50" Y2="50"
                                          Stroke="{DynamicResource Brush.Border}" StrokeThickness="1" />
                                    <Polyline Points="{Binding AcknowledgementAgePoints}"
                                              Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2.5" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <DockPanel Margin="0,3,0,0">
                            <TextBlock Text="60 s ago" Style="{StaticResource Text.Tiny}" />
                            <TextBlock Text="Now" Style="{StaticResource Text.Tiny}" HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Lobby players" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Each card shows both sharing directions. Status words remain visible alongside the lights."
                       Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,8" />
            <ItemsControl ItemsSource="{Binding Peers}" ItemTemplate="{StaticResource PeerTemplate}"
                          Visibility="{Binding HasPeers, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="No other players are visible in this lobby."
                       Style="{StaticResource Text.Muted}" Margin="0,2,0,14"
                       Visibility="{Binding HasNoPeers, Converter={StaticResource BoolToVis}}" />

            <Grid Margin="0,6,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Live log viewer" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="The newest 2,000 matching lines are kept on screen."
                               Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ViewerCountText}"
                           Style="{StaticResource Text.Muted}" VerticalAlignment="Bottom" />
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="SENDER" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding SenderFilters}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedSenderId, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="LOG" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding FileFilters}" DisplayMemberPath="Name"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedFileName, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="FIND LITERAL TEXT" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,3" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Find literal text in visible logs" />
                </StackPanel>
                <CheckBox Grid.Column="3" Content="Follow newest line" IsChecked="{Binding AutoScroll}"
                          VerticalAlignment="Bottom" Margin="0,0,0,6" />
            </Grid>

            <Border Style="{StaticResource Card}" Padding="0" Height="400">
                <Grid>
                    <ListBox x:Name="LiveLogList" ItemsSource="{Binding VisibleLogLines}"
                             Background="Transparent" BorderThickness="0" Padding="6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,3" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background"
                                                            Value="{DynamicResource Brush.PanelAlt}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background"
                                                            Value="{DynamicResource Brush.Selection}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Row" Property="BorderBrush"
                                                            Value="{DynamicResource Brush.Accent}" />
                                                    <Setter TargetName="Row" Property="BorderThickness" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" FontFamily="Consolas"
                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SenderName}" Margin="6,0"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding FileName}" Margin="6,0"
                                               Foreground="{DynamicResource Brush.Accent}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Text}" Margin="6,0,0,0"
                                               FontFamily="Consolas" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No log lines match the current filters."
                               Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoViewerLines, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
