<Window x:Class="RainWorldCompanion.Views.SaveEditsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Save the changes"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <StackPanel Margin="20">
        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding TargetText}"
                   Style="{StaticResource Text.Muted}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,16" />

        <TextBlock Text="{Binding ChangeHeader}" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,6" />
        <Border Style="{StaticResource Card}" Padding="10,8" MaxHeight="240">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Changes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" Margin="0,0,0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!--
            The advice from the panel, repeated here. A value the game will read differently is
            worth seeing again at the moment it stops being undoable by closing the editor.
        -->
        <Border Style="{StaticResource Banner.Warn}" Margin="0,12,0,0"
                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="WORTH KNOWING" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" Margin="0,0,0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="10,8"
                Background="{StaticResource Brush.PanelAlt}">
            <StackPanel>
                <TextBlock Text="A backup is taken first" Style="{StaticResource Text.Value}" />
                <TextBlock Text="{Binding BackupText}"
                           Style="{StaticResource Text.Muted}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding SizeText}"
                   Style="{StaticResource Text.Tiny}"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save the changes" Style="{StaticResource Button.Accent}" Margin="0,0,8,0"
                    Click="OnSave" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
