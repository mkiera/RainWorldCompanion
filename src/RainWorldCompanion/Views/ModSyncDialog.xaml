<Window x:Class="RainWorldCompanion.Views.ModSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Mods"
        Width="720"
        Height="760"
        MinWidth="560"
        MinHeight="440"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- The tick is the mod's state, not a request to change it, so a row nothing is doing
             anything to still shows where it stands. -->
        <DataTemplate x:Key="ModToggleRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Margin="0,1,8,0" VerticalAlignment="Top"
                          IsChecked="{Binding Wanted, Mode=TwoWay}"
                          IsEnabled="{Binding Installed}"
                          AutomationProperties.Name="{Binding AccessibleName}" />

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StateText}" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Accent}"
                               Visibility="{Binding StateText, Converter={StaticResource StringToVis}}" />
                </StackPanel>

                <Button Grid.Column="2" VerticalAlignment="Top"
                        Style="{StaticResource Button.Tiny}"
                        Content="Steam Workshop"
                        Click="OnOpenWorkshopPage"
                        Visibility="{Binding HasWorkshopPage, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding HeadlineText}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <Border Style="{StaticResource Banner.Warn}"
                    Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ProblemText}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Banner.Info}" Margin="0,6,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Undo my changes"
                    Style="{StaticResource Button.Tiny}"
                    Command="{Binding RevertChangesCommand}" />

            <Button DockPanel.Dock="Right" Content="Match the save" Margin="0,0,8,0"
                    Style="{StaticResource Button.Tiny}"
                    Command="{Binding MatchTheSaveCommand}"
                    Visibility="{Binding IsMatchingASave, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="{Binding ChangeText}" VerticalAlignment="Center" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,10,0" />
        </DockPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>
                <StackPanel Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}"
                            Margin="0,0,0,12">
                    <TextBlock Text="{Binding MissingHeader}" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Warn}" />
                    <TextBlock Text="Subscribe in Steam, then press Refresh to pick them up."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Missing}" ItemTemplate="{StaticResource ModToggleRow}"
                                  Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding ModsHeader}" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <ItemsControl ItemsSource="{Binding Mods}" ItemTemplate="{StaticResource ModToggleRow}"
                              Margin="0,2,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding HasRestorePoint, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restore my previous mods"
                        Style="{StaticResource Button.Small}"
                        Command="{Binding RestorePreviousCommand}" />
                <TextBlock Text="{Binding RestorePointText}" VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,10,0" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    AutomationProperties.HelpText="Look at the mods folder again after subscribing in Steam" />

            <Button DockPanel.Dock="Right" Content="Close" Click="OnClose" Margin="8,0,0,0" />

            <Button DockPanel.Dock="Right" Content="Launch Rain World"
                    Click="OnLaunchGame" Margin="8,0,0,0"
                    Visibility="{Binding CanLaunch, Converter={StaticResource BoolToVis}}" />

            <Button DockPanel.Dock="Right" Content="Apply"
                    Style="{StaticResource Button.Accent}"
                    Command="{Binding ApplyCommand}" />

            <TextBlock />
        </DockPanel>
    </Grid>
</Window>
