<Window x:Class="RainWorldCompanion.Views.ModSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Mods"
        Width="720"
        Height="660"
        MinWidth="560"
        MinHeight="440"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- One mod. The tick is what applying acts on, so a row applying cannot act on shows no
             box at all rather than a dead one. A mod that is not installed has nowhere to be
             turned on from, which is what the Steam button is for. -->
        <DataTemplate x:Key="ModSyncRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" Margin="0,1,8,0" VerticalAlignment="Top"
                          IsChecked="{Binding Include, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding AccessibleName}"
                          Visibility="{Binding CanChoose, Converter={StaticResource BoolToVis}}" />

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="2" VerticalAlignment="Top"
                        Style="{StaticResource Button.Tiny}"
                        Content="Steam Workshop"
                        Click="OnOpenWorkshopPage"
                        Visibility="{Binding HasWorkshopPage, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding HeadlineText}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <Border Style="{StaticResource Banner.Warn}"
                    Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ProblemText}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Banner.Info}" Margin="0,6,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>
                <StackPanel Visibility="{Binding HasTurnOn, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding TurnOnHeader}" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Ok}" />
                    <ItemsControl ItemsSource="{Binding TurnOn}" ItemTemplate="{StaticResource ModSyncRow}"
                                  Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding HasTurnOff, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding TurnOffHeader}" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Warn}" />
                    <ItemsControl ItemsSource="{Binding TurnOff}" ItemTemplate="{StaticResource ModSyncRow}"
                                  Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding HasInstall, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding InstallHeader}" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Warn}" />
                    <TextBlock Text="Subscribe in Steam, then press Refresh to pick them up."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Install}" ItemTemplate="{StaticResource ModSyncRow}"
                                  Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding HasMatching, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding MatchingHeader}" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextMuted}" />
                    <ItemsControl ItemsSource="{Binding Matching}" ItemTemplate="{StaticResource ModSyncRow}"
                                  Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding HasRestorePoint, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restore my previous mods"
                        Style="{StaticResource Button.Small}"
                        Command="{Binding RestorePreviousCommand}" />
                <TextBlock Text="{Binding RestorePointText}" VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,10,0" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    AutomationProperties.HelpText="Look at the mods folder again after subscribing in Steam" />

            <Button DockPanel.Dock="Right" Content="Close" Click="OnClose" Margin="8,0,0,0" />

            <Button DockPanel.Dock="Right" Content="Launch Rain World"
                    Click="OnLaunchGame" Margin="8,0,0,0"
                    Visibility="{Binding CanLaunch, Converter={StaticResource BoolToVis}}" />

            <Button DockPanel.Dock="Right" Content="Apply"
                    Style="{StaticResource Button.Accent}"
                    Command="{Binding ApplyCommand}" />

            <TextBlock />
        </DockPanel>
    </Grid>
</Window>
