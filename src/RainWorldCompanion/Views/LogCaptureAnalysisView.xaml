<UserControl x:Class="RainWorldCompanion.Views.LogCaptureAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:RainWorldCompanion.Controls"
             xmlns:analysis="clr-namespace:RainWorldCompanion.Core.LogStreaming.Analysis;assembly=RainWorldCompanion.Core"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="1000"
             Foreground="{DynamicResource Brush.Text}"
             KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources>
        <Style x:Key="AnalysisMetric" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style x:Key="IncidentBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.PanelAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="9" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static analysis:CaptureEventSeverity.Warning}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warn}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static analysis:CaptureEventSeverity.Error}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static analysis:CaptureEventSeverity.Critical}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModBuildBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ok}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasMismatch}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasVerificationGap}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Capture timeline" Style="{StaticResource Text.Title}" FontSize="20" />
                    <TextBlock Text="Replay a saved capture or follow the current capture as it grows."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding CaptureName, Mode=OneWay}" FontWeight="SemiBold" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding CaptureFolder, Mode=OneWay}" />
                    <TextBlock Text="{Binding LiveFollowText, Mode=OneWay}" Style="{StaticResource Text.Muted}" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Button Content="Load capture" Command="{Binding LoadCaptureCommand}"
                            Style="{StaticResource Button.Accent}" Margin="6,0,0,6" />
                    <Button Content="Use current capture" Command="{Binding UseCurrentCaptureCommand}"
                            Style="{StaticResource Button.Small}" Margin="6,0,0,6" />
                    <Button Content="Refresh" Command="{Binding RefreshCaptureCommand}"
                            Style="{StaticResource Button.Small}" Margin="6,0,0,6" />
                </WrapPanel>
            </Grid>

            <Border Style="{StaticResource Banner.Info}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding WarningText, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.Warn}"
                               Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Banner.Danger}" Margin="0,0,0,10"
                    Visibility="{Binding HasModMismatches, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="LOBBY MOD BUILDS DO NOT MATCH" Style="{StaticResource Text.SectionLabel}"
                               Foreground="{DynamicResource Brush.Danger}" />
                    <TextBlock Text="{Binding ModMismatchSummary, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Banner.Warn}" Margin="0,0,0,10"
                    Visibility="{Binding HasModVerificationGaps, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="MOD BUILD CHECK INCOMPLETE" Style="{StaticResource Text.SectionLabel}"
                               Foreground="{DynamicResource Brush.Warn}" />
                    <TextBlock Text="{Binding ModVerificationSummary, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,0,6">
                <Border Style="{StaticResource AnalysisMetric}">
                    <StackPanel><TextBlock Text="DURATION" Style="{StaticResource Text.SectionLabel}" /><TextBlock Text="{Binding DurationText, Mode=OneWay}" FontSize="19" /></StackPanel>
                </Border>
                <Border Style="{StaticResource AnalysisMetric}">
                    <StackPanel><TextBlock Text="PEOPLE" Style="{StaticResource Text.SectionLabel}" /><TextBlock Text="{Binding ParticipantCountText, Mode=OneWay}" FontSize="19" /></StackPanel>
                </Border>
                <Border Style="{StaticResource AnalysisMetric}">
                    <StackPanel><TextBlock Text="LOG COVERAGE" Style="{StaticResource Text.SectionLabel}" /><TextBlock Text="{Binding LogCoverageText, Mode=OneWay}" FontSize="19" /><TextBlock Text="people sharing / visible" Style="{StaticResource Text.Tiny}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource AnalysisMetric}">
                    <StackPanel><TextBlock Text="ERRORS" Style="{StaticResource Text.SectionLabel}" /><TextBlock Text="{Binding ErrorCountText, Mode=OneWay}" FontSize="19" Foreground="{DynamicResource Brush.Danger}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource AnalysisMetric}">
                    <StackPanel><TextBlock Text="WARNINGS" Style="{StaticResource Text.SectionLabel}" /><TextBlock Text="{Binding WarningCountText, Mode=OneWay}" FontSize="19" Foreground="{DynamicResource Brush.Warn}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource AnalysisMetric}">
                    <StackPanel><TextBlock Text="SHARED INCIDENTS" Style="{StaticResource Text.SectionLabel}" /><TextBlock Text="{Binding CrossPlayerIncidentText, Mode=OneWay}" FontSize="19" /></StackPanel>
                </Border>
                <Border Style="{StaticResource AnalysisMetric}">
                    <StackPanel><TextBlock Text="CAPTURE HEALTH" Style="{StaticResource Text.SectionLabel}" /><TextBlock Text="{Binding CaptureHealthText, Mode=OneWay}" FontSize="17" /><TextBlock Text="{Binding CaptureHealthDetail, Mode=OneWay}" Style="{StaticResource Text.Tiny}" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Style="{StaticResource AnalysisMetric}">
                    <StackPanel><TextBlock Text="PLAYHEAD" Style="{StaticResource Text.SectionLabel}" /><TextBlock Text="{Binding CursorText, Mode=OneWay}" FontSize="15" /></StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Background="{DynamicResource Brush.PanelAlt}" Margin="10,10,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding PlaybackActionText, Mode=OneWay}" Command="{Binding TogglePlaybackCommand}"
                                Style="{StaticResource Button.Accent}" Margin="0,0,6,0" MinWidth="62" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding PlaybackRates}" SelectedItem="{Binding PlaybackRate}"
                                  Width="68" Margin="0,0,6,0" ToolTip="Playback speed"
                                  AutomationProperties.Name="Timeline playback speed">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding StringFormat={}{0:0.##}×}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <WrapPanel Grid.Column="2">
                            <Button Content="Previous alert" Command="{Binding PreviousAlertCommand}" Style="{StaticResource Button.Small}" Margin="0,0,5,0" />
                            <Button Content="Next alert" Command="{Binding NextAlertCommand}" Style="{StaticResource Button.Small}" Margin="0,0,5,0" />
                            <Button Content="Focus event" Command="{Binding FocusSelectionCommand}" Style="{StaticResource Button.Small}" Margin="0,0,5,0" />
                            <Button Content="Fit session" Command="{Binding FitTimelineCommand}" Style="{StaticResource Button.Small}" />
                        </WrapPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox Content="Follow live edge" IsChecked="{Binding FollowLiveEdge}" Margin="8,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="10,0,0,0">
                            <DockPanel><TextBlock Text="Time" Style="{StaticResource Text.Tiny}" /><TextBlock Text="{Binding HorizontalScaleText, Mode=OneWay}" Style="{StaticResource Text.Tiny}" HorizontalAlignment="Right" /></DockPanel>
                            <Slider Minimum="1" Maximum="200" Value="{Binding HorizontalZoom}" IsSnapToTickEnabled="False" AutomationProperties.Name="Timeline horizontal zoom" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="10,6,10,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
                        <WrapPanel>
                            <CheckBox Content="Errors" IsChecked="{Binding ShowErrors}" Margin="0,0,10,3" />
                            <CheckBox Content="Warnings" IsChecked="{Binding ShowWarnings}" Margin="0,0,10,3" />
                            <CheckBox Content="Room changes" IsChecked="{Binding ShowMovement}" Margin="0,0,10,3" />
                            <CheckBox Content="Connections" IsChecked="{Binding ShowConnections}" Margin="0,0,10,3" />
                            <CheckBox Content="Actions" IsChecked="{Binding ShowActions}" Margin="0,0,10,3" />
                            <CheckBox Content="Other" IsChecked="{Binding ShowOtherEvents}" Margin="0,0,10,3" />
                        </WrapPanel>
                        <StackPanel Grid.Column="1">
                            <DockPanel><TextBlock Text="Lane height" Style="{StaticResource Text.Tiny}" /><TextBlock Text="{Binding LaneScaleText, Mode=OneWay}" Style="{StaticResource Text.Tiny}" HorizontalAlignment="Right" /></DockPanel>
                            <Slider Minimum="26" Maximum="90" Value="{Binding LaneHeight}" AutomationProperties.Name="Timeline lane height" />
                        </StackPanel>
                    </Grid>

                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1"
                            Background="#101214" Height="360" ClipToBounds="True">
                        <ScrollViewer x:Name="TimelineVerticalScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <controls:CaptureTimelineCanvas x:Name="TimelineCanvas" MinHeight="350"
                                                            Tracks="{Binding TimelineTracks, Mode=OneWay}"
                                                            Incidents="{Binding Incidents, Mode=OneWay}"
                                                            VisibleStart="{Binding VisibleStart, Mode=OneWay}"
                                                            VisibleEnd="{Binding VisibleEnd, Mode=OneWay}"
                                                            CursorTime="{Binding CursorTime, Mode=TwoWay}"
                                                            LaneHeight="{Binding LaneHeight, Mode=TwoWay}"
                                                            SelectedMoment="{Binding SelectedMoment, Mode=TwoWay}"
                                                            SelectedIncident="{Binding SelectedIncident, Mode=TwoWay}"
                                                            AutomationProperties.Name="Capture event timeline" />
                        </ScrollViewer>
                    </Border>
                    <Grid Margin="10,6,10,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <WrapPanel>
                            <TextBlock Text="◆ Error / ! Critical" Foreground="#FF6B73" Margin="0,0,12,0" />
                            <TextBlock Text="▲ Warning" Foreground="#E0A83D" Margin="0,0,12,0" />
                            <TextBlock Text="◆ Room / player" Foreground="#46C7D9" Margin="0,0,12,0" />
                            <TextBlock Text="● Network" Foreground="#B58AE8" Margin="0,0,12,0" />
                            <TextBlock Text="▮ Action / marker" Foreground="#62C98A" />
                        </WrapPanel>
                        <TextBlock Grid.Column="1" Text="{Binding VisibleRangeText, Mode=OneWay}" Style="{StaticResource Text.Muted}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="5*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="4*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Alerts across players" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="Errors within two seconds are grouped so a lobby-wide failure is visible at a glance."
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,8" />
                        <ListBox ItemsSource="{Binding Incidents}" SelectedItem="{Binding SelectedIncident}"
                                 Height="270" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource IncidentBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="94" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding AlertText, Mode=OneWay}" FontWeight="Bold" FontSize="10" />
                                                <TextBlock Text="{Binding TimeText, Mode=OneWay}" FontFamily="Consolas" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Summary, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding PlayersText, Mode=OneWay}" Style="{StaticResource Text.Muted}" />
                                                <TextBlock Text="{Binding LocationText, Mode=OneWay}" Style="{StaticResource Text.Tiny}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="No error incidents were found in the available logs."
                                   Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,16"
                                   Visibility="{Binding HasNoIncidents, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Selected event" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="{Binding SelectedTimingText, Mode=OneWay}" Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,4,0,7" />
                        <TextBox Text="{Binding SelectedDetails, Mode=OneWay}" IsReadOnly="True"
                                 Height="96" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                        <TextBlock Text="Possible mod causes" Style="{StaticResource Text.SectionLabel}" Margin="0,10,0,4" />
                        <ItemsControl ItemsSource="{Binding PossibleCauses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.PanelAlt}" CornerRadius="4" Padding="8" Margin="0,0,0,5">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ScoreText, Mode=OneWay}" Foreground="{DynamicResource Brush.Warn}" HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <ProgressBar Maximum="1" Value="{Binding Cause.Likelihood, Mode=OneWay}" Height="5" Margin="0,4" />
                                            <TextBlock Text="{Binding EvidenceText, Mode=OneWay}" Style="{StaticResource Text.Tiny}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No mod has enough evidence for this event."
                                   Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                                   Visibility="{Binding HasNoPossibleCauses, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="Likelihoods organize evidence for investigation. Timing and correlation cannot prove a cause."
                                   Style="{StaticResource Text.Tiny}" TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <controls:CaptureReplayMapCanvas x:Name="ReplayMap" Height="410"
                                                         Map="{Binding CurrentMap, Mode=OneWay}"
                                                         Players="{Binding PlayersAtCursor, Mode=OneWay}"
                                                         CursorTime="{Binding CursorTime, Mode=OneWay}"
                                                         AutomationProperties.Name="Player locations on the game map" />
                        <Border Background="#B5101214" Padding="8" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Location at playhead" Foreground="White" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MapStatus, Mode=OneWay}" Foreground="#D5D8DC" TextWrapping="Wrap" MaxWidth="430" />
                            </StackPanel>
                        </Border>
                        <WrapPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="8">
                            <Button Content="Fit map" Click="FitMap_Click" Style="{StaticResource Button.Small}" Margin="0,0,5,0" />
                            <Button Content="+" Click="ZoomMapIn_Click" Style="{StaticResource Button.Small}" Width="34" Margin="0,0,5,0" />
                            <Button Content="−" Click="ZoomMapOut_Click" Style="{StaticResource Button.Small}" Width="34" />
                        </WrapPanel>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Players at playhead" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="Native Meadow observations fill some gaps. Players without shared logs are labeled as partial coverage."
                                   Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,8" />
                        <ItemsControl ItemsSource="{Binding PlayersAtCursor}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.PanelAlt}" BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" VerticalAlignment="Top" Margin="0,4,8,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Brush.Accent}" /><Style.Triggers><DataTrigger Binding="{Binding HasNearbyError}" Value="True"><Setter Property="Fill" Value="{DynamicResource Brush.Danger}" /></DataTrigger></Style.Triggers></Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding LocationText, Mode=OneWay}" FontFamily="Consolas" />
                                                <TextBlock Text="{Binding CoverageText, Mode=OneWay}" Style="{StaticResource Text.Tiny}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding State, Mode=OneWay}" />
                                                <TextBlock Text="HOST" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Meadow}"
                                                           Visibility="{Binding IsHost, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No player location was recorded before this point."
                                   Style="{StaticResource Text.Muted}" Margin="0,12" HorizontalAlignment="Center"
                                   Visibility="{Binding HasNoPlayersAtCursor, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <UniformGrid Columns="2" Margin="0,0,0,6">
                <Border Style="{StaticResource Card}" Margin="0,0,6,6" Padding="10">
                    <StackPanel><DockPanel><TextBlock Text="Error activity" Style="{StaticResource Text.Title}" /><TextBlock Text="{Binding ErrorScaleText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource Text.Muted}" /></DockPanel><Viewbox Height="115" Stretch="Fill" Margin="0,8,0,0"><Canvas Width="600" Height="100" Background="{DynamicResource Brush.PanelAlt}"><Line X1="0" X2="600" Y1="50" Y2="50" Stroke="{DynamicResource Brush.Border}" /><Polyline Points="{Binding ErrorActivityPoints}" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="2" /></Canvas></Viewbox></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10">
                    <StackPanel><DockPanel><TextBlock Text="Network latency" Style="{StaticResource Text.Title}" /><TextBlock Text="{Binding PingScaleText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource Text.Muted}" /></DockPanel><Viewbox Height="115" Stretch="Fill" Margin="0,8,0,0"><Canvas Width="600" Height="100" Background="{DynamicResource Brush.PanelAlt}"><Line X1="0" X2="600" Y1="50" Y2="50" Stroke="{DynamicResource Brush.Border}" /><Polyline Points="{Binding PingPoints}" Stroke="#B58AE8" StrokeThickness="2" /></Canvas></Viewbox></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,6,6" Padding="10">
                    <StackPanel><DockPanel><TextBlock Text="Frame time" Style="{StaticResource Text.Title}" /><TextBlock Text="{Binding FrameScaleText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource Text.Muted}" /></DockPanel><Viewbox Height="115" Stretch="Fill" Margin="0,8,0,0"><Canvas Width="600" Height="100" Background="{DynamicResource Brush.PanelAlt}"><Line X1="0" X2="600" Y1="50" Y2="50" Stroke="{DynamicResource Brush.Border}" /><Polyline Points="{Binding FrameTimePoints}" Stroke="#46C7D9" StrokeThickness="2" /></Canvas></Viewbox></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="10">
                    <StackPanel><DockPanel><TextBlock Text="Managed memory" Style="{StaticResource Text.Title}" /><TextBlock Text="{Binding MemoryScaleText, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource Text.Muted}" /></DockPanel><Viewbox Height="115" Stretch="Fill" Margin="0,8,0,0"><Canvas Width="600" Height="100" Background="{DynamicResource Brush.PanelAlt}"><Line X1="0" X2="600" Y1="50" Y2="50" Stroke="{DynamicResource Brush.Border}" /><Polyline Points="{Binding MemoryPoints}" Stroke="#62C98A" StrokeThickness="2" /></Canvas></Viewbox></StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Mod build comparison" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="A complete code fingerprint identifies the mod DLLs a player ran. A red row means the lobby did not match, even when every mod reported the same version. Amber means the available data cannot verify a match."
                               Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,3,0,8" />
                    <ItemsControl ItemsSource="{Binding ModComparison}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModBuildBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><TextBlock Text="{Binding Id, Mode=OneWay}" Style="{StaticResource Text.Tiny}" /></StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="8,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Builds, Mode=OneWay}" FontFamily="Consolas" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No comparable mod inventory was recorded before the playhead."
                               Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,12"
                               Visibility="{Binding HasNoModComparison, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel><TextBlock Text="Events in view" Style="{StaticResource Text.Title}" /><TextBlock Text="Click an event to move every panel to the same time." Style="{StaticResource Text.Muted}" /></StackPanel>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding VisibleEvents}" SelectedValuePath="Moment" SelectedValue="{Binding SelectedMoment}"
                             Height="310" Background="Transparent" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="5,4" /></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="98" /><ColumnDefinition Width="130" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText, Mode=OneWay}" FontFamily="Consolas" />
                                    <TextBlock Grid.Column="1" Text="{Binding Sender, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="6,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding SeverityText, Mode=OneWay}" Margin="6,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Summary, Mode=OneWay}" TextTrimming="CharacterEllipsis" Margin="6,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding Location, Mode=OneWay}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="6,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No events match the current filters and visible time range."
                               Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" Margin="0,12"
                               Visibility="{Binding HasNoVisibleEvents, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
