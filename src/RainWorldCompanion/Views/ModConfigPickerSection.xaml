<UserControl x:Class="RainWorldCompanion.Views.ModConfigPickerSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Visibility="{Binding ShowSection, Converter={StaticResource BoolToVis}}">

    <UserControl.Resources>
        <!-- The tick is the point of the row, so it wraps the whole thing rather than sitting
             beside it. -->
        <DataTemplate x:Key="SettingsRow">
            <CheckBox Margin="0,4" IsChecked="{Binding Take, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding Name}">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Notes}"
                                  Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </UserControl.Resources>

    <Border CornerRadius="4" Padding="12,10"
            Background="{StaticResource Brush.PanelAlt}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock Text="SETTINGS" FontWeight="Bold" FontSize="11"
                       Foreground="{StaticResource Brush.TextMuted}" />

            <TextBlock Text="{Binding HeadlineText}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SettingsRow}" />
            </ScrollViewer>

            <TextBlock Text="{Binding FooterText}" Style="{StaticResource Text.Muted}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
