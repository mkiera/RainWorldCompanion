<Window x:Class="RainWorldCompanion.Views.WhatsNewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Headline}"
        Width="620"
        Height="560"
        MinWidth="420"
        MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Headline}"
                   Style="{StaticResource Text.Title}"
                   TextWrapping="Wrap" />

        <!-- One block per release, so a reader who skipped a version can see which one brought
             what. Plain text inside a block on purpose, the same way the Updates window shows a
             release's notes: the entries are short lines and reading them needs no markdown
             renderer. -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,14,0,0"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14">
                            <!-- Named only when there are several. One release's notes under a
                                 heading naming the version the title already gives would just be
                                 the same word twice. -->
                            <TextBlock Text="{Binding Version}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"
                                       Visibility="{Binding DataContext.ShowVersions,
                                                            RelativeSource={RelativeSource AncestorType=Window},
                                                            Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Notes}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Text}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Got it"
                MinWidth="86"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Style="{StaticResource Button.Accent}"
                IsDefault="True"
                IsCancel="True" />
    </Grid>
</Window>
