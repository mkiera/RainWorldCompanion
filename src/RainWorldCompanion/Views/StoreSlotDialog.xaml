<Window x:Class="RainWorldCompanion.Views.StoreSlotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Store a slot in the library"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <DataTemplate x:Key="CampaignLine">
            <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding}" Margin="0,1" />
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Store a slot in the library" Style="{StaticResource Text.Title}" />
        <TextBlock Text="A copy of the slot is kept under a name of your choosing. The slot itself is not changed."
                   Style="{StaticResource Text.Muted}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,16" />

        <DockPanel>
            <ComboBox DockPanel.Dock="Right" Width="196"
                      ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                      AutomationProperties.Name="Slot to store" />
            <TextBlock Text="SLOT" Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="{Binding SourceName}" Style="{StaticResource Text.Title}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SourceSummary}" Style="{StaticResource Text.Muted}"
                           Margin="0,2,0,0" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding SourceCampaigns}" ItemTemplate="{StaticResource CampaignLine}"
                              Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="NAME" Style="{StaticResource Text.SectionLabel}" Margin="0,16,0,4" />
        <TextBox x:Name="NameBox" MaxLength="120"
                 Text="{Binding EntryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Name for this save" />

        <TextBlock Text="NOTE (OPTIONAL)" Style="{StaticResource Text.SectionLabel}" Margin="0,14,0,4" />
        <TextBox x:Name="NoteBox"
                 Height="72"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Note" />

        <DockPanel Margin="0,20,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="StoreButton" Content="Store" Style="{StaticResource Button.Accent}"
                        IsDefault="True" Margin="0,0,8,0" Click="OnStore"
                        IsEnabled="{Binding CanStore}" />
                <Button Content="Cancel" IsCancel="True" />
            </StackPanel>
            <TextBlock Text="{Binding BlockedReason}" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Warn}"
                       Visibility="{Binding BlockedReason, Converter={StaticResource StringToVis}}" />
        </DockPanel>
    </StackPanel>
</Window>
