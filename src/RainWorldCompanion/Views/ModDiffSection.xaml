<UserControl x:Class="RainWorldCompanion.Views.ModDiffSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Visibility="{Binding ShowSection, Converter={StaticResource BoolToVis}}">

    <UserControl.Resources>
        <!-- One row: what the mod is called, what is different about it, and the two ways of
             acting on that. A local mod has no page to open, so the button is bound away
             rather than drawn dead. -->
        <DataTemplate x:Key="ModRow">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ActionText}" Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap"
                               Visibility="{Binding ActionText, Converter={StaticResource StringToVis}}" />
                </StackPanel>

                <Button Grid.Column="1" VerticalAlignment="Top"
                        Style="{StaticResource Button.Tiny}"
                        Content="Steam Workshop"
                        Click="OnOpenWorkshopPage"
                        Visibility="{Binding HasWorkshopPage, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NoteLine">
            <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,1" />
        </DataTemplate>
    </UserControl.Resources>

    <Border CornerRadius="4" Padding="12,10"
            Background="{StaticResource Brush.PanelAlt}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock Text="MODS" FontWeight="Bold" FontSize="11"
                       Foreground="{StaticResource Brush.TextMuted}" />

            <TextBlock Text="{Binding HeadlineText}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <Button HorizontalAlignment="Left" Margin="0,8,0,0"
                    Style="{StaticResource Button.Small}"
                    Content="{Binding FixModsText}"
                    Click="OnFixMods"
                    Visibility="{Binding CanFixMods, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.HelpText="Open the Mods window on this save's mod list" />

            <CheckBox Margin="0,8,0,0"
                      IsChecked="{Binding Acknowledged, Mode=TwoWay}"
                      Content="{Binding AcknowledgeText}"
                      Visibility="{Binding NeedsAcknowledgement, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.Name="{Binding AcknowledgeText}" />

            <ItemsControl ItemsSource="{Binding GroupNotes}" ItemTemplate="{StaticResource NoteLine}"
                          Margin="0,6,0,0"
                          Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200" Margin="0,8,0,0"
                          Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding MissingHeader}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Warn}" />
                        <ItemsControl ItemsSource="{Binding Missing}" ItemTemplate="{StaticResource ModRow}"
                                      Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding HasTurnedOff, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding TurnedOffHeader}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Warn}" />
                        <ItemsControl ItemsSource="{Binding TurnedOff}" ItemTemplate="{StaticResource ModRow}"
                                      Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding HasChanged, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ChangedHeader}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Changed}" ItemTemplate="{StaticResource ModRow}"
                                      Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding HasExtra, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ExtraHeader}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextMuted}" />
                        <ItemsControl ItemsSource="{Binding Extra}" ItemTemplate="{StaticResource ModRow}"
                                      Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
