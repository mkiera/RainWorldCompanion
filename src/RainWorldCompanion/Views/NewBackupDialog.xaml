<Window x:Class="RainWorldCompanion.Views.NewBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="New backup"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <StackPanel Margin="20">
        <TextBlock Text="New backup" Style="{StaticResource Text.Title}" />
        <TextBlock Text="A snapshot of the current save folder is copied into the backup folder."
                   Style="{StaticResource Text.Muted}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,16" />

        <TextBlock Text="LABEL (OPTIONAL)" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="LabelBox" MaxLength="80" />

        <TextBlock Text="NOTE (OPTIONAL)" Style="{StaticResource Text.SectionLabel}" Margin="0,14,0,4" />
        <TextBox x:Name="NoteBox"
                 Height="96"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto" />

        <Expander Header="What gets copied" Margin="0,14,0,0" Foreground="{StaticResource Brush.TextMuted}">
            <ItemsControl ItemsSource="{Binding ScopeRules}" Margin="4,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Create" Style="{StaticResource Button.Accent}" IsDefault="True" Margin="0,0,8,0"
                    Click="OnCreate" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
