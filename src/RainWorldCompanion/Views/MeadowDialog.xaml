<Window x:Class="RainWorldCompanion.Views.MeadowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Rain Meadow"
        Width="780"
        Height="600"
        MinWidth="640"
        MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right"
                    Content="Refresh"
                    Style="{StaticResource Button.Small}"
                    Command="{Binding RefreshCommand}" />
            <StackPanel>
                <TextBlock Text="Rain Meadow" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="{Binding FriendsText}"
                       Style="{StaticResource Text.Muted}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasFriendsText, Converter={StaticResource BoolToVis}}" />
            <Border Padding="10" Margin="0,8,0,0"
                    Background="{DynamicResource Brush.Panel}"
                    Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ProblemText}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Danger}" />
            </Border>
            <TextBlock Text="{Binding PolicyNote}"
                       Style="{StaticResource Text.Muted}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Visibility="{Binding HasNoteAboutPolicy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ListBox ItemsSource="{Binding Lobbies}"
                     SelectedItem="{Binding SelectedLobby, Mode=TwoWay}"
                     HorizontalContentAlignment="Stretch"
                     AutomationProperties.Name="Lobbies">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding FriendText}"
                                           Style="{StaticResource Text.Muted}"
                                           Margin="10,0,0,0"
                                           Visibility="{Binding HasFriend, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding ChangeText}"
                                       Style="{StaticResource Text.Muted}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="No lobbies listed. Refresh, or paste a join code below."
                       Style="{StaticResource Text.Muted}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="{Binding HasNoLobbies, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,12,0,0"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8"
                        Visibility="{Binding NeedsPassword, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Password" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding LobbyPassword, UpdateSourceTrigger=PropertyChanged}"
                         Width="220"
                         MaxLength="200"
                         AutomationProperties.Name="Lobby password" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Sync mods and join"
                        Style="{StaticResource Button.Accent}"
                        Margin="0,0,8,0"
                        Command="{Binding SyncAndJoinCommand}" />
                <Button Content="Join without changing mods"
                        Style="{StaticResource Button.Small}"
                        Command="{Binding JoinCommand}" />
            </StackPanel>
        </StackPanel>

        <Expander Grid.Row="4" Header="Paste a join code" Margin="0,12,0,0"
                  Foreground="{DynamicResource Brush.TextMuted}">
            <StackPanel Margin="4,8,0,0">
                <TextBlock Text="A lobby id, a join code starting with +connect_lobby, or a Steam invite link."
                           Style="{StaticResource Text.Muted}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6" />
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="Join"
                            Style="{StaticResource Button.Small}"
                            Margin="8,0,0,0"
                            Command="{Binding JoinTypedCommand}" />
                    <TextBox Text="{Binding TypedCode, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Lobby id, join code or invite link" />
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Password" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding TypedPassword, UpdateSourceTrigger=PropertyChanged}"
                             Width="220"
                             MaxLength="200"
                             AutomationProperties.Name="Password for the pasted lobby" />
                </StackPanel>
                <TextBlock Text="{Binding TypedProblem}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource Brush.Danger}"
                           Visibility="{Binding HasTypedProblem, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Expander>
    </Grid>
</Window>
