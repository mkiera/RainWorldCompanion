<Window x:Class="RainWorldCompanion.Views.ModProfileNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Headline}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <StackPanel Margin="20">
        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Subtitle}"
                   Style="{StaticResource Text.Muted}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,16" />

        <TextBlock Text="NAME" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" MaxLength="80" AutomationProperties.Name="Profile name" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{Binding ActionText}"
                    Style="{StaticResource Button.Accent}"
                    IsDefault="True"
                    Margin="0,0,8,0"
                    Click="OnAccept" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
