<Window x:Class="RainWorldCompanion.Views.UpdatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Updates"
        Width="680"
        Height="620"
        MinWidth="560"
        MinHeight="440"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <!-- One channel. A button rather than a radio button because the whole card is the
             target: the description is the part that says what picking it means, so it has to
             be clickable too. -->
        <Style x:Key="ChannelCard" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="{StaticResource Brush.Panel}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Brush.Selection}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowShell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Updates" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{Binding RunningVersionText}"
                           Style="{StaticResource Text.Muted}"
                           Margin="0,3,0,0" />
                <TextBlock Text="{Binding LastCheckedText}"
                           Style="{StaticResource Text.Muted}"
                           Margin="0,1,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Check now"
                    Style="{StaticResource Button.Small}"
                    VerticalAlignment="Top"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding CanRefresh}" />
        </Grid>

        <!-- The three trains -->
        <ItemsControl Grid.Row="1"
                      Margin="0,16,0,0"
                      ItemsSource="{Binding Channels}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ChannelCard}"
                            Margin="0,0,8,0"
                            Command="{Binding DataContext.SelectChannelCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}"
                                       Style="{StaticResource Text.Tiny}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Whatever the last action had to say, plus the download bar. Both come from the shared
             updater, so the banner in the main window and this window never disagree. -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <Border Style="{StaticResource Banner.Warn}"
                    Visibility="{Binding IsProblem, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.Warn}" />
            </Border>

            <TextBlock Text="{Binding Updates.StatusMessage}"
                       TextWrapping="Wrap"
                       Style="{StaticResource Text.Muted}"
                       Visibility="{Binding Updates.HasStatus, Converter={StaticResource BoolToVis}}" />

            <ProgressBar Height="6"
                         Margin="0,8,0,0"
                         Minimum="0" Maximum="100"
                         Value="{Binding Updates.DownloadPercent, Mode=OneWay}"
                         Visibility="{Binding Updates.IsDownloading, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="Reading the list..."
                       Style="{StaticResource Text.Muted}"
                       Margin="0,6,0,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- Releases -->
        <ScrollViewer Grid.Row="3"
                      Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsAlpha, Converter={StaticResource NotBoolToVis}}">
            <ItemsControl ItemsSource="{Binding Releases}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowShell}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                                            <Border Style="{StaticResource Chip}"
                                                    Margin="8,0,0,0"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Running now" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Style="{StaticResource Text.Muted}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="Notes"
                                            Style="{StaticResource Button.Small}"
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.OpenReleasePageCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />

                                    <Button Grid.Column="2"
                                            Content="{Binding ActionVerb}"
                                            MinWidth="96"
                                            Style="{StaticResource Button.Small}"
                                            Command="{Binding DataContext.InstallReleaseCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>

                                <TextBlock Text="{Binding ConfirmationText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource Brush.Warn}"
                                           Visibility="{Binding IsArmed, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Branch builds. No version and no notes: nothing here was tagged, and the run page is
             the only thing that describes it. -->
        <ScrollViewer Grid.Row="3"
                      Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsAlpha, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding BranchBuilds}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowShell}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                        <Border Style="{StaticResource Chip}"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Running now" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}"
                                               Style="{StaticResource Text.Muted}"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Run"
                                        Style="{StaticResource Button.Small}"
                                        Margin="0,0,8,0"
                                        Command="{Binding DataContext.OpenRunPageCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />

                                <Button Grid.Column="2"
                                        Content="Install"
                                        MinWidth="96"
                                        Style="{StaticResource Button.Small}"
                                        Command="{Binding DataContext.InstallBranchCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CheckBox Grid.Column="0"
                      Content="Check for updates automatically"
                      VerticalAlignment="Center"
                      IsChecked="{Binding AutoCheck, Mode=TwoWay}" />

            <Button Grid.Column="1"
                    Content="Close"
                    MinWidth="86"
                    Style="{StaticResource Button.Small}"
                    Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
</Window>
