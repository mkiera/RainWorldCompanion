<Window x:Class="RainWorldCompanion.Views.DeleteSlotDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Delete a slot"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <StackPanel Margin="20">
        <TextBlock Text="{Binding HeadlineText}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding TargetText}"
                   Style="{StaticResource Text.Muted}"
                   TextWrapping="Wrap"
                   Margin="0,4,0,16" />

        <!-- Every campaign named, not counted. A slot holding three runs is where somebody means
             one of them and reaches for the wrong button. -->
        <TextBlock Text="{Binding ListHeader}" Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,6" />
        <Border Style="{StaticResource Card}" Padding="10,8" MaxHeight="200">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Campaigns}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}"
                                       TextWrapping="Wrap" Margin="0,0,0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <CheckBox Content="{Binding MapChoiceText}"
                  IsChecked="{Binding TakeTheMap, Mode=TwoWay}"
                  Margin="0,14,0,0" />

        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="10,8">
            <StackPanel>
                <TextBlock Text="{Binding EffectText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StaysText}"
                           Style="{StaticResource Text.Muted}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="10,8"
                Background="{StaticResource Brush.PanelAlt}">
            <StackPanel>
                <TextBlock Text="A backup is taken first" Style="{StaticResource Text.Value}" />
                <TextBlock Text="{Binding SafetyText}"
                           Style="{StaticResource Text.Muted}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding BlockedReason}"
                   Style="{StaticResource Text.Muted}"
                   Foreground="{StaticResource Brush.Warn}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"
                   Visibility="{Binding BlockedVisibility}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Delete it" Style="{StaticResource Button.Accent}" Margin="0,0,8,0"
                    IsEnabled="{Binding CanDelete}" Click="OnDelete" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
