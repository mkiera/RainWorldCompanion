<Window x:Class="RainWorldCompanion.Views.TakeSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RainWorldCompanion.Views"
        mc:Ignorable="d"
        Title="Take mod settings"
        Width="640"
        Height="720"
        MinWidth="460"
        MinHeight="360"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Everything above the buttons scrolls, so Take and Cancel stay reachable on a short
             screen however many mods a save turns out to carry. -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Subtitle}"
                           Style="{StaticResource Text.Muted}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />

                <views:ModConfigPickerSection DataContext="{Binding Settings}" Margin="0,14,0,0" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="86" IsCancel="True" />
            <Button DockPanel.Dock="Right"
                    Content="Take settings"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Style="{StaticResource Button.Accent}"
                    IsDefault="True"
                    IsEnabled="{Binding Settings.HasAnyTaken}"
                    Click="OnTake" />
            <TextBlock Text="A safety copy of your saves is taken first, so this can be undone."
                       Style="{StaticResource Text.Muted}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
