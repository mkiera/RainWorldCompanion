<Window x:Class="RainWorldCompanion.Views.DenMapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RainWorldCompanion.Controls"
        Title="Choose a den" Width="1280" Height="820" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="−" Width="34" MinWidth="34" Click="ZoomOut" ToolTip="Zoom out" AutomationProperties.Name="Zoom out" Style="{StaticResource Button.Small}" />
                <Button Content="+" Width="34" MinWidth="34" Margin="5,0,12,0" Click="ZoomIn" ToolTip="Zoom in" AutomationProperties.Name="Zoom in" Style="{StaticResource Button.Small}" />
                <Button Content="Fit world" Click="FitWorld" Style="{StaticResource Button.Small}" />
                <Button Content="Current den" Margin="6,0,0,0" Click="FocusCurrent" IsEnabled="{Binding HasCurrentDen}" Style="{StaticResource Button.Small}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding MapTitle}" FontWeight="SemiBold" FontSize="17" />
                <TextBlock Text="Scroll to zoom. Drag to pan. Select a den to inspect it." Style="{StaticResource Text.Muted}" Margin="0,3,16,0" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="Black">
                <controls:DenMapCanvas x:Name="Map" AutomationProperties.Name="{Binding MapTitle}"
                                       AutomationProperties.HelpText="Drag to pan and scroll to zoom. Use the den list to select with the keyboard." />
            </Border>
            <Grid Grid.Column="1" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <Label Content="Find a den or region" Target="{Binding ElementName=SearchBox}" Padding="0,0,0,5" Foreground="{DynamicResource Brush.Text}" />
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Find a den or region" />
                    <Label Content="Campaign timeline" Target="{Binding ElementName=TimelineBox}" Foreground="{DynamicResource Brush.Text}" Padding="0,9,0,5" />
                    <ComboBox x:Name="TimelineBox" ItemsSource="{Binding TimelineOptions}" DisplayMemberPath="Label"
                              SelectedValuePath="Id" SelectedValue="{Binding Timeline, Mode=OneWay}"
                              SelectionChanged="TimelineChanged" AutomationProperties.Name="Campaign timeline" />
                    <TextBlock Text="{Binding TimelineAdvice}" TextWrapping="Wrap" Style="{StaticResource Text.Muted}" Margin="0,7,0,0" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding MatchCountText}" Style="{StaticResource Text.Muted}" Margin="0,7,0,7" />
                <ListBox x:Name="DenList" Grid.Row="2" ItemsSource="{Binding Matches}" SelectedItem="{Binding SelectedDen, Mode=TwoWay}"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Dens">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItem.Card}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="3,4">
                                <TextBlock Text="{Binding RoomId}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RegionName}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="{Binding CurrentText}" TextWrapping="Wrap" Style="{StaticResource Text.Muted}" />
                    <TextBlock Margin="0,8,0,0" Text="Cyan ring: current den. Gold ring: selected den." TextWrapping="Wrap" Style="{StaticResource Text.Muted}" />
                    <TextBlock Margin="0,4,0,0" Text="Dimmed icon: unavailable in this timeline." TextWrapping="Wrap" Style="{StaticResource Text.Muted}" />
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
                <TextBlock Text="{Binding SelectedRoomText}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedRegionText}" Margin="0,2,0,0" />
                <TextBlock Text="{Binding SelectionAdvice}"
                           TextWrapping="Wrap" Style="{StaticResource Text.Muted}" Margin="0,7,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Cancel" IsCancel="True" MinWidth="80" Style="{StaticResource Button.Small}" />
                <Button Content="Use den" Click="UseDen" IsEnabled="{Binding CanUseDen}" MinWidth="100" Margin="8,0,0,0" Style="{StaticResource Button.Accent}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
