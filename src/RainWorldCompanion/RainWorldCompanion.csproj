<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RainWorldCompanion.Core\RainWorldCompanion.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RainWorldCompanion.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Which CI run produced this exe, so the list of branch builds can mark the row the user is
         actually running. Set only by the branch-build workflow: a release is built from a tag,
         and stamping a tag name into a field called BuildBranch would be a lie in every release.
         Both degrade to absent, which the app reads back as blank. -->
    <AssemblyMetadata Include="BuildBranch" Value="$(BuildBranch)" Condition="'$(BuildBranch)' != ''" />
    <AssemblyMetadata Include="BuildRunId" Value="$(BuildRunId)" Condition="'$(BuildRunId)' != ''" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <!-- Sets the exe's own icon, which is what Explorer, the taskbar and any window that does not
         name one of its own all pick up. app.ico holds 16 through 256 in one file: Windows chooses
         a size per surface, and leaving one out means it scales a neighbour and the result looks
         soft next to everything around it.

         app-icon-source.png is the art it was built from, kept beside it so the ico can be rebuilt
         without going hunting. Nothing in the build reads the png. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
