<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:RainWorldCompanion.Converters">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:NotBooleanToVisibilityConverter x:Key="NotBoolToVis" />
    <conv:StringToVisibilityConverter x:Key="StringToVis" />

    <!-- Palette: muted neutrals with one slate accent, plus green/red/amber for state -->
    <SolidColorBrush x:Key="Brush.Window" Color="#FFF2F2F0" />
    <SolidColorBrush x:Key="Brush.Panel" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.PanelAlt" Color="#FFF8F8F6" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FFD9D9D3" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FFBDBDB5" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FF23262B" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#FF6C7079" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF4B6E7F" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFA33A34" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FFFBEDEC" />
    <SolidColorBrush x:Key="Brush.Ok" Color="#FF2E7D50" />
    <SolidColorBrush x:Key="Brush.OkSoft" Color="#FFEDF6F0" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#FF8A6D1F" />
    <SolidColorBrush x:Key="Brush.WarnSoft" Color="#FFFBF4E2" />
    <!-- Rain Meadow. A colour of its own so the online block reads as a different category at a
         glance rather than as more of the local saves above it. Kept in the same muted family as
         the rest, and away from Ok, Warn and Danger, which all mean a state here. -->
    <SolidColorBrush x:Key="Brush.Meadow" Color="#FF5A6E4B" />
    <SolidColorBrush x:Key="Brush.MeadowSoft" Color="#FFF2F5EE" />

    <SolidColorBrush x:Key="Brush.Selection" Color="#FFE1EAEE" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#66202225" />

    <!-- Text. These are keyed on purpose: an implicit TextBlock style would also repaint
         the text inside button and header templates. -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Text.SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The number or word inside a stat tile -->
    <Style x:Key="Text.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.Tiny" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="94" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.74" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Button.Base}" />

    <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.AccentText}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
    </Style>

    <Style x:Key="Button.Small" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- For a button carrying one character, such as an arrow, where a word's width is all gap. -->
    <Style x:Key="Button.Tiny" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--
        A button that stays pressed, for something that is opened rather than done. Its own
        template rather than one based on Button.Base, because a style cannot retarget a
        ControlTemplate from Button to ToggleButton.
    -->
    <Style x:Key="Button.SmallToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Selection}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}" />
    </Style>

    <!-- Cards and banners -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="Banner.Warn" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.WarnSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Warn}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <!-- For news rather than faults. An available update is a good thing, and putting it in the
         same amber as a misconfigured save folder would say "problem" about it, especially when
         both are on screen at once. -->
    <Style x:Key="Banner.Info" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Selection}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style x:Key="Banner.Danger" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <!-- Slugcat portraits. The art is 84x84 pixel art, so it is drawn with nearest neighbour at
         every size. Bilinear turns the faces to mush. The image itself is never null: a slugcat
         with no art in the install gets a drawn head in the same colour. -->
    <DataTemplate x:Key="Portrait.Small">
        <Border Width="24" Height="24" Margin="0,0,4,0" CornerRadius="4"
                Background="{Binding AccentSoft}"
                BorderBrush="{Binding Accent}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                ToolTip="{Binding ToolTipText}">
            <Image Source="{Binding Image}" Width="20" Height="20"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Portrait.Large">
        <Border Width="46" Height="46" CornerRadius="5"
                Background="{Binding AccentSoft}"
                BorderBrush="{Binding Accent}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                ToolTip="{Binding ToolTipText}">
            <Image Source="{Binding Image}" Width="40" Height="40"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>
    </DataTemplate>

    <!-- Small pills: gate names, echo counts, swallowed items -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.PanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Margin" Value="0,0,5,5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- One labelled value in a detail group -->
    <Style x:Key="StatTile" TargetType="Border">
        <Setter Property="Width" Value="136" />
        <Setter Property="Background" Value="{StaticResource Brush.PanelAlt}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Rows in the backup list. The strip down the left marks the selected one. -->
    <Style x:Key="ListItem.Card" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="{StaticResource Brush.Panel}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Marker" Width="3" HorizontalAlignment="Left"
                                    CornerRadius="5,0,0,5" Background="Transparent" />
                            <ContentPresenter Margin="11,8" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.PanelAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource Brush.Selection}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="Marker" Property="Background" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListItem.Card}" />
    </Style>

</ResourceDictionary>
