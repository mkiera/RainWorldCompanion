<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:RainWorldCompanion.Converters">

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:NotBooleanToVisibilityConverter x:Key="NotBoolToVis" />
    <conv:StringToVisibilityConverter x:Key="StringToVis" />

    <!-- Text. These are keyed on purpose: an implicit TextBlock style would also repaint
         the text inside button and header templates. -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Text.SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The number or word inside a stat tile -->
    <Style x:Key="Text.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.Tiny" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinWidth" Value="94" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.74" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Button.Base}" />

    <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
    </Style>

    <Style x:Key="Button.Small" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- For a button carrying one character, such as an arrow, where a word's width is all gap. -->
    <Style x:Key="Button.Tiny" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A button using this carries no word, so it needs AutomationProperties.Name to have a name. -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Small}">
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- Drawn here rather than taken from an icon set, so nothing in the repo carries a licence. -->
    <Geometry x:Key="Icon.Gear">F0 M 10.28,1.14 A 11,11 0 0 1 13.72,1.14 L 14.32,3.93 A 8.4,8.4 0 0 1 16.07,4.65 L 18.47,3.1 A 11,11 0 0 1 20.9,5.53 L 19.35,7.93 A 8.4,8.4 0 0 1 20.07,9.68 L 22.86,10.28 A 11,11 0 0 1 22.86,13.72 L 20.07,14.32 A 8.4,8.4 0 0 1 19.35,16.07 L 20.9,18.47 A 11,11 0 0 1 18.47,20.9 L 16.07,19.35 A 8.4,8.4 0 0 1 14.32,20.07 L 13.72,22.86 A 11,11 0 0 1 10.28,22.86 L 9.68,20.07 A 8.4,8.4 0 0 1 7.93,19.35 L 5.53,20.9 A 11,11 0 0 1 3.1,18.47 L 4.65,16.07 A 8.4,8.4 0 0 1 3.93,14.32 L 1.14,13.72 A 11,11 0 0 1 1.14,10.28 L 3.93,9.68 A 8.4,8.4 0 0 1 4.65,7.93 L 3.1,5.53 A 11,11 0 0 1 5.53,3.1 L 7.93,4.65 A 8.4,8.4 0 0 1 9.68,3.93 L 10.28,1.14 Z M 12,8.3 A 3.7,3.7 0 0 0 12,15.7 A 3.7,3.7 0 0 0 12,8.3 Z</Geometry>

    <!-- Shorter than the buttons either side, so it reads as a divider rather than as a column. -->
    <Style x:Key="Toolbar.Separator" TargetType="Rectangle">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        A button that stays pressed, for something that is opened rather than done. Its own
        template rather than one based on Button.Base, because a style cannot retarget a
        ControlTemplate from Button to ToggleButton.
    -->
    <Style x:Key="Button.SmallToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Selection}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- Cards and banners -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="Banner.Warn" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warn}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <!-- For news rather than faults. An available update is a good thing, and putting it in the
         same amber as a misconfigured save folder would say "problem" about it, especially when
         both are on screen at once. -->
    <Style x:Key="Banner.Info" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <Style x:Key="Banner.Danger" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,9" />
    </Style>

    <!-- Slugcat portraits. The art is 84x84 pixel art, so it is drawn with nearest neighbour at
         every size. Bilinear turns the faces to mush. The image itself is never null: a slugcat
         with no art in the install gets a drawn head in the same colour.

         The backing is the slugcat's own colour laid over the panel at low opacity rather than a
         tint mixed in the view model, so the same square reads as pale on a light panel and deep
         on a dark one without either theme naming a colour per slugcat. -->
    <DataTemplate x:Key="Portrait.Small">
        <Border Width="24" Height="24" Margin="0,0,4,0" CornerRadius="4"
                BorderBrush="{Binding Accent}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                ToolTip="{Binding ToolTipText}">
            <Grid>
                <Border CornerRadius="3" Background="{Binding Accent}" Opacity="0.18" />
                <Image Source="{Binding Image}" Width="20" Height="20"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Portrait.Large">
        <Border Width="46" Height="46" CornerRadius="5"
                BorderBrush="{Binding Accent}"
                BorderThickness="1"
                SnapsToDevicePixels="True"
                ToolTip="{Binding ToolTipText}">
            <Grid>
                <Border CornerRadius="4" Background="{Binding Accent}" Opacity="0.18" />
                <Image Source="{Binding Image}" Width="40" Height="40"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Small pills: gate names, echo counts, swallowed items -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.PanelAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Margin" Value="0,0,5,5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- One labelled value in a detail group -->
    <Style x:Key="StatTile" TargetType="Border">
        <Setter Property="Width" Value="136" />
        <Setter Property="Background" Value="{DynamicResource Brush.PanelAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Rows in the backup list. The strip down the left marks the selected one. -->
    <Style x:Key="ListItem.Card" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root"
                            Background="{DynamicResource Brush.Panel}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Marker" Width="3" HorizontalAlignment="Left"
                                    CornerRadius="5,0,0,5" Background="Transparent" />
                            <ContentPresenter Margin="11,8" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.PanelAlt}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Selection}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Marker" Property="Background" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListItem.Card}" />
    </Style>

</ResourceDictionary>
